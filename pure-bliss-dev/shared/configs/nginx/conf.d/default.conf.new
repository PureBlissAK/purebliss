# Upstream definitions for all services
upstream keycloak {
    server purebliss-keycloak:8080;
}
upstream codeserver {
    server purebliss-codeserver:8080;
}
upstream vikunja {
    server purebliss-vikunja:3456;
}
upstream grafana {
    server purebliss-grafana:3000;
}
upstream vault {
    server purebliss-vault:8200;
}
upstream prometheus {
    server purebliss-prometheus:9090;
}
upstream loki {
    server purebliss-loki:3100;
}

# HTTP server -> HTTPS redirect
server {
    listen 80;
    server_name dev.purebliss.app;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
        try_files $uri =404;
    }

    location / {
        return 301 https://$server_name$request_uri;
    }
}

# HTTPS server
server {
    listen 443 ssl http2;
    server_name dev.purebliss.app;

    # SSL Config
    ssl_certificate /etc/nginx/certs/live/dev.purebliss.app/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/live/dev.purebliss.app/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Security Headers
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Serve the tools dashboard
    location /tools/ {
        alias /opt/dev-purebliss/web/tools/;
        index index.html;
        try_files $uri $uri/ =404;
    }
    location = /tools {
        return 301 $scheme://$host/tools/;
    }

    # Proxy configurations for all services
    location /codeserver/ {
        proxy_pass http://codeserver/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location /auth/ {
        proxy_pass http://keycloak/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /vikunja/ {
        proxy_pass http://vikunja/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /grafana/ {
        proxy_pass http://grafana/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /vault/ {
        proxy_pass http://vault/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /prometheus/ {
        proxy_pass http://prometheus/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /loki/ {
        proxy_pass http://loki/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health check
    location /health {
        access_log off;
        return 200 "healthy\n";
    }

    # Default redirect
    location / {
        return 302 https://$server_name/tools/;
    }
}
