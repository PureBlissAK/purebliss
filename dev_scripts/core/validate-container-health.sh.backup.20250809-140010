            log_health "ERROR" "❌ Dependency $dep_service is not running ($dep_status)"
        fi
    else
        echo "Dependency $dep_service: Not found" >> "$report_file"
        log_health "ERROR" "❌ Dependency $dep_service container not found"
    fi
}

