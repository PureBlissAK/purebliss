            validate_dependency_independent keycloak postgres connectivity
            POSTGRES_STATUS=$?
            if [[ $POSTGRES_STATUS -ne 0 ]]; then
                echo "❌ Keycloak: PostgreSQL dependency validation failed. Redis will NOT be tested."
