#!/bin/bash

# Safe Single Script Migration with Infrastructure Testing
# Migrates ONE script at a time with immediate container testing
# CRITICAL: Tests infrastructure after each migration to ensure 100% functionality

set -euo pipefail

CENTRAL_REPO="/opt/dev-purebliss/dev_scripts"
MIGRATION_LOG="/opt/my-secure-ha-stack/logs/dev-environment-setup.log"

# Log function
log_migration() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - SINGLE_SCRIPT_MIGRATION: $1" >> "$MIGRATION_LOG"
    echo "$1"
}

# Automated PROJECT_PLAN documentation update function
update_project_plan_issue() {
    local issue_id="$1"
    local action="$2"  # "create", "update", "resolve"
    local script_name="$3"
    local status="$4"  # For updates: status description
    
    local project_plan="/opt/dev-purebliss/PROJECT_PLAN_ENHANCED.md"
    local temp_file="/tmp/project_plan_update.tmp"
    
    case "$action" in
        "create")
            log_migration "AUTO_DOC: Creating PROJECT_PLAN issue entry for $script_name"
            # Add issue to medium priority table (automated entries)
            sed '/| ISS-002 | vault | Missing Docker health check configuration | 📋 Identified | Add health check to vault container | 2025-08-07 |/a\
| '"$issue_id"' | scripts | Script migration: '"$script_name"' | 🔄 In Progress | Automated script centralization | '"$(date +%Y-%m-%d)"' |' "$project_plan" > "$temp_file"
            mv "$temp_file" "$project_plan"
            ;;
        "update")
            log_migration "AUTO_DOC: Updating PROJECT_PLAN issue $issue_id status: $status"
            # Update existing issue status
            sed "s/| $issue_id | scripts | Script migration: $script_name | [^|]* | [^|]* |/| $issue_id | scripts | Script migration: $script_name | $status | Automated script centralization |/g" "$project_plan" > "$temp_file"
            mv "$temp_file" "$project_plan"
            ;;
        "resolve")
            log_migration "AUTO_DOC: Resolving PROJECT_PLAN issue $issue_id for $script_name"
            # Move from medium priority to resolved issues table
            # First, extract the issue line
            local issue_line=$(grep "| $issue_id |" "$project_plan" | head -1)
            if [[ -n "$issue_line" ]]; then
                # Update to resolved status and move to resolved table
                local resolved_line="${issue_line/| 🔄 In Progress |/| ✅ Complete |}"
                resolved_line="${resolved_line/| 📋 Identified |/| ✅ Complete |}"
                # Remove from medium priority table
                grep -v "| $issue_id |" "$project_plan" > "$temp_file"
                # Add to resolved issues table
                sed '/| ISS-003 | scripts | retry-utils.sh script centralization | ✅ Complete | Moved to \/opt\/dev-purebliss\/dev_scripts\/utilities\/ | 2025-08-07 |/a\
'"$resolved_line"' '"$(date +%Y-%m-%d)"' |' "$temp_file" > "$project_plan"
                rm "$temp_file"
            fi
            ;;
    esac
    
    log_migration "AUTO_DOC: PROJECT_PLAN updated for issue $issue_id"
}

# Generate next available issue ID
get_next_issue_id() {
    local project_plan="/opt/dev-purebliss/PROJECT_PLAN_ENHANCED.md"
    
    # Extract all ISS-XXX IDs and find the highest number
    local highest_id=$(grep -o "ISS-[0-9][0-9][0-9]" "$project_plan" | sed 's/ISS-//' | sort -n | tail -1)
    
    if [[ -z "$highest_id" ]]; then
        echo "ISS-001"
    else
        local next_num=$((highest_id + 1))
        printf "ISS-%03d" "$next_num"
    fi
}

# Update script migration progress in PROJECT_PLAN
update_migration_progress() {
    local total_scripts="$1"
    local completed_scripts="$2"
    local current_script="$3"
    
    local project_plan="/opt/dev-purebliss/PROJECT_PLAN_ENHANCED.md"
    local temp_file="/tmp/project_plan_progress.tmp"
    local percentage=$(( (completed_scripts * 100) / total_scripts ))
    
    log_migration "AUTO_DOC: Updating migration progress: $completed_scripts/$total_scripts ($percentage%)"
    
    # Update the script migration progress section
    sed "s/#### Centralization Status: [0-9]*\/[0-9]* Scripts Complete ([0-9.]*%)/#### Centralization Status: $completed_scripts\/$total_scripts Scripts Complete ($percentage%)/" "$project_plan" > "$temp_file"
    
    # Update the completed scripts list if provided
    if [[ -n "$current_script" ]]; then
        # Add current script to completed list
        sed "/\\*\\*✅ COMPLETED\\*\\*:/a\\
- $current_script → /opt/dev-purebliss/dev_scripts/utilities/$current_script" "$temp_file" > "$project_plan"
        rm "$temp_file"
    else
        mv "$temp_file" "$project_plan"
    fi
    
    log_migration "AUTO_DOC: Migration progress updated in PROJECT_PLAN"
}

# Create backup before migration
create_script_backup() {
    local script_path="$1"
    local script_name=$(basename "$script_path")
    local backup_path="/opt/dev-purebliss/backup-${script_name}-$(date +%Y%m%d-%H%M%S)"
    
    if [[ -f "$script_path" ]]; then
        cp "$script_path" "$backup_path"
        log_migration "Created backup: $backup_path"
        echo "$backup_path"  # Return backup path
    else
        log_migration "ERROR: Script not found: $script_path"
        return 1
    fi
}

# Safe script migration with immediate testing
migrate_single_script() {
    local source_script="$1"
    local target_path="$2"
    local affected_services="$3"  # Space-separated list of services to test
    
    local script_name=$(basename "$source_script")
    log_migration "Starting migration: $script_name"
    log_migration "Source: $source_script"
    log_migration "Target: $target_path"
    log_migration "Affected services: $affected_services"
    
    # AUTO_DOC: Create PROJECT_PLAN issue for this migration
    local issue_id=$(get_next_issue_id)
    update_project_plan_issue "$issue_id" "create" "$script_name" "🔄 In Progress"
    
    # Step 1: Create backup
    local backup_path="/opt/dev-purebliss/backup-${script_name}-$(date +%Y%m%d-%H%M%S)"
    if ! cp "$source_script" "$backup_path"; then
        log_migration "ERROR: Failed to create backup"
        update_project_plan_issue "$issue_id" "update" "$script_name" "❌ Failed - Backup creation failed"
        return 1
    fi
    log_migration "Created backup: $backup_path"
    
    # Step 2: Ensure target directory exists
    mkdir -p "$(dirname "$target_path")"
    
    # Step 3: Copy script to new location (don't delete original yet)
    cp "$source_script" "$target_path"
    chmod +x "$target_path"
    log_migration "Copied script to: $target_path"
    update_project_plan_issue "$issue_id" "update" "$script_name" "🔄 Files copied, testing in progress"
    
    # Step 4: Update references in affected containers
    update_script_references "$script_name" "$source_script" "$target_path" "$affected_services"
    
    # Step 5: Test affected services using centralized validation
    if test_affected_services "$affected_services"; then
        # Step 5.5: Use centralized script migration validation tool
        validate_migration_with_central_tool "$script_name" "$affected_services"
        
        # Step 6: Only remove original if tests pass
        rm "$source_script"
        log_migration "SUCCESS: Migration complete, original removed"
        log_migration "Backup available at: $backup_path"
        
        # AUTO_DOC: Mark issue as resolved in PROJECT_PLAN
        update_project_plan_issue "$issue_id" "resolve" "$script_name" "✅ Complete"
        
        # AUTO_DOC: Update overall migration progress
        # Count completed scripts in the central repo
        local completed_count=$(find /opt/dev-purebliss/dev_scripts -name "*.sh" -type f | wc -l)
        update_migration_progress "36" "$completed_count" "$script_name"
        
        return 0
    else
        # Step 7: Rollback on failure
        update_project_plan_issue "$issue_id" "update" "$script_name" "❌ Failed - Rolling back"
        rollback_migration "$script_name" "$source_script" "$target_path" "$backup_path" "$affected_services"
        update_project_plan_issue "$issue_id" "update" "$script_name" "❌ Failed - Rollback complete"
        return 1
    fi
}

# Update script references in container files
update_script_references() {
    local script_name="$1"
    local old_path="$2"
    local new_path="$3"
    local affected_services="$4"
    
    log_migration "Updating references for $script_name"
    
    # Find all files referencing the script
    while IFS= read -r file; do
        if [[ -f "$file" && "$file" != "$old_path" && "$file" != "$new_path" ]]; then
            log_migration "Updating references in: $file"
            # Use sed to replace the path
            sed -i.bak "s|$old_path|$new_path|g" "$file"
            sed -i.bak "s|/opt/dev-purebliss/$script_name|$new_path|g" "$file"
            sed -i.bak "s|\\./$script_name|$new_path|g" "$file"
        fi
    done < <(grep -r "$script_name" /opt/dev-purebliss/ --include="*.sh" -l 2>/dev/null || true)
}

# Use centralized validation tool for migration verification
validate_migration_with_central_tool() {
    local script_name="$1"
    local affected_services="$2"
    
    local validation_tool="/opt/dev-purebliss/dev_scripts/utilities/validate-script-migration.sh"
    
    if [[ -x "$validation_tool" ]]; then
        log_migration "Using centralized migration validation tool"
        
        for service in $affected_services; do
            if "$validation_tool" "$service"; then
                log_migration "✓ $service: Migration validation passed"
            else
                log_migration "✗ $service: Migration validation failed"
                return 1
            fi
        done
    else
        log_migration "WARNING: Centralized validation tool not found, using basic validation"
    fi
}

# Test affected services
test_affected_services() {
    local services="$1"
    
    log_migration "Testing affected services: $services"
    
    if [[ -z "$services" || "$services" == "none" ]]; then
        log_migration "No services to test"
        return 0
    fi
    
    for service in $services; do
        log_migration "Testing service: $service"
        
        # Check if container exists and is running
        if docker ps -q -f name="$service" >/dev/null 2>&1; then
            log_migration "Container $service is running"
            
            # Test basic health
            if docker exec "$service" echo "health check" >/dev/null 2>&1; then
                log_migration "✓ $service: Basic connectivity test passed"
            else
                log_migration "✗ $service: Basic connectivity test failed"
                return 1
            fi
            
            # Test service-specific health if script exists
            if [[ -x "/opt/dev-purebliss/validate-container-health.sh" ]]; then
                if /opt/dev-purebliss/validate-container-health.sh "$service" "script-migration-test" >/dev/null 2>&1; then
                    log_migration "✓ $service: Health validation passed"
                else
                    log_migration "✗ $service: Health validation failed"
                    return 1
                fi
            fi
        else
            log_migration "Service $service not running - skipping test"
        fi
    done
    
    log_migration "All service tests passed"
    return 0
}

# Rollback migration on failure
rollback_migration() {
    local script_name="$1"
    local original_path="$2"
    local new_path="$3"
    local backup_path="$4"
    local affected_services="$5"
    
    log_migration "ROLLBACK: Migration failed, restoring original state"
    
    # Restore original script
    cp "$backup_path" "$original_path"
    chmod +x "$original_path"
    
    # Remove failed new location
    rm -f "$new_path"
    
    # Restore original references
    while IFS= read -r file; do
        if [[ -f "$file.bak" ]]; then
            mv "$file.bak" "$file"
            log_migration "Restored references in: $file"
        fi
    done < <(find /opt/dev-purebliss -name "*.bak" 2>/dev/null || true)
    
    log_migration "ROLLBACK COMPLETE: Original state restored"
}

# Reboot and validate system using existing centralized tool
reboot_and_validate() {
    local services="$1"
    
    log_migration "Using centralized service restart validation tool"
    
    # Use existing centralized restart validation tool
    local restart_tool="/opt/dev-purebliss/dev_scripts/utilities/service-restart-validation.sh"
    
    if [[ ! -x "$restart_tool" ]]; then
        log_migration "ERROR: Centralized restart validation tool not found: $restart_tool"
        return 1
    fi
    
    for service in $services; do
        log_migration "Restarting and validating service: $service"
        
        # Convert purebliss-service to just service for restart tool
        local service_name=${service#purebliss-}
        
        if "$restart_tool" "$service_name" --full-validation; then
            log_migration "✓ $service: Restart and validation successful"
        else
            log_migration "✗ $service: Restart and validation failed - CRITICAL"
            return 1
        fi
    done
    
    log_migration "All services restarted and validated successfully"
    return 0
}

# Main execution function for single script migration
main() {
    local script_to_migrate="$1"
    local target_category="$2"
    local affected_services="${3:-none}"
    
    log_migration "=== AUTOMATED PROJECT_PLAN DOCUMENTATION ENABLED ==="
    log_migration "AUTO_DOC: Will automatically track migration progress in PROJECT_PLAN_ENHANCED.md"
    
    case "$script_to_migrate" in
        "retry-utils.sh")
            migrate_single_script "/opt/dev-purebliss/retry-utils.sh" \
                                "$CENTRAL_REPO/utilities/retry-utils.sh" \
                                "keycloak"
            ;;
        "service-entrypoint-template.sh")
            migrate_single_script "/opt/dev-purebliss/service-entrypoint-template.sh" \
                                "$CENTRAL_REPO/utilities/service-entrypoint-template.sh" \
                                "none"
            ;;
        "verify-https.sh")
            migrate_single_script "/opt/dev-purebliss/verify-https.sh" \
                                "$CENTRAL_REPO/health-checks/verify-https.sh" \
                                "nginx"
            ;;
        "comprehensive-health-check.sh")
            migrate_single_script "/opt/dev-purebliss/dev_scripts/health-checks/comprehensive-health-check.sh" \
                                "$CENTRAL_REPO/health-checks/comprehensive-health-check.sh" \
                                "none"
            ;;
        "https-sanity-check.sh")
            migrate_single_script "/opt/dev-purebliss/dev_scripts/health-checks/https-sanity-check.sh" \
                                "$CENTRAL_REPO/health-checks/https-sanity-check.sh" \
                                "none"
            ;;
        "upstream-validation.sh")
            migrate_single_script "/opt/dev-purebliss/upstream-validation.sh" \
                                "$CENTRAL_REPO/utilities/upstream-validation.sh" \
                                "nginx"
            ;;
        *)
            log_migration "ERROR: Unknown script: $script_to_migrate"
            echo "Usage: $0 <script_name> <category> [affected_services]"
            echo "Example: $0 retry-utils.sh utilities keycloak"
            return 1
            ;;
    esac
    
    # Reboot and validate after successful migration
    if [[ "$affected_services" != "none" ]]; then
        reboot_and_validate "$affected_services"
    fi
    
    log_migration "=== SINGLE SCRIPT MIGRATION COMPLETE ==="
    log_migration "AUTO_DOC: PROJECT_PLAN_ENHANCED.md has been automatically updated with migration results"
}

# Execute if called directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
