# Multi-phase Nginx container scaffolding - Enhanced from existing Pure Bliss work
# Based on: /opt/dev-purebliss/services/nginx/nginx-dockerfile
ARG BUILD_PHASE=6

# Phase 1: Minimal Nginx (Base from existing)
FROM nginx:latest AS phase1
RUN apt-get update && apt-get install -y \
    curl
RUN if [ -f /opt/dev-purebliss/services/nginx/nginx-minimal.conf ]; then \
    cp /opt/dev-purebliss/services/nginx/nginx-minimal.conf /etc/nginx/nginx.conf; \
  elif [ -f /opt/dev-purebliss/services/nginx/nginx-simple.conf ]; then \
    cp /opt/dev-purebliss/services/nginx/nginx-simple.conf /etc/nginx/nginx.conf; \
  else \
    echo 'events{} http{ server{ listen 80; location /health { return 200 "healthy"; } } }' > /etc/nginx/nginx.conf; \
  fi
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/health || exit 1
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# Phase 2: Enhanced Configuration (Existing configs)
FROM phase1 AS phase2
RUN apt-get install -y openssl jq
COPY nginx.conf /etc/nginx/nginx.conf
COPY config/ /etc/nginx/conf.d/
RUN mkdir -p /etc/nginx/certs
EXPOSE 443

# Phase 3: Service Integration (Vault integration from existing)
FROM phase2 AS phase3
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
COPY scripts/ /opt/scripts/
COPY templates/ /opt/templates/
ENV VAULT_ADDR=https://127.0.0.1:8200 DOMAIN=dev.purebliss.app

# Phase 4: Advanced Features (SSL/TLS automation from existing)
FROM phase3 AS phase4
COPY certs/ /etc/nginx/certs/
COPY *.sh /opt/scripts/
RUN chmod +x /opt/scripts/*.sh || true
ENV USE_VAULT=true
ENV SSL_AUTO_RENEW=true

# Phase 5: Production Readiness (Monitoring and logging)
FROM phase4 AS phase5
RUN mkdir -p /var/log/nginx /opt/my-secure-ha-stack/logs
COPY logs/ /var/log/nginx/
USER nginx
ENV AUDIT_LOGGING=true
ENV SECURITY_HEADERS=true

# Phase 6: Elite Features (Full existing functionality)
FROM phase5 AS phase6
COPY . /opt/nginx-config/
ENV VAULT_SKIP_VERIFY=true
ENV ADVANCED_MONITORING=true
ENV AUTO_HEALING=true

# Final stage selection based on BUILD_PHASE
FROM phase${BUILD_PHASE} AS final
ENTRYPOINT ["/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
