# Multi-phase grafana container scaffolding - Enhanced from existing Pure Bliss work
# Based on: /opt/dev-purebliss/services/grafana/grafana-dockerfile
ARG BUILD_PHASE=6

# Phase 1: Minimal Container (Base from existing)
FROM grafana/grafana:10.1.0 AS phase1

HEALTHCHECK --interval=30s --timeout=10s CMD wget -q --spider http://localhost:3000/ || exit 1
EXPOSE 3000

# Phase 2: Enhanced Configuration (Existing configs)
FROM phase1 AS phase2
# RUN apt-get install -y jq openssl
# COPY /opt/dev-purebliss/services/grafana/configs/ /opt/config/ 2>/dev/null || true
# COPY /opt/dev-purebliss/services/grafana/*.conf /opt/config/ 2>/dev/null || true


# Phase 3: Service Integration (Vault integration from existing)
FROM phase2 AS phase3
# Copy entrypoint script (should already be executable in build context)
COPY vault-entrypoint.sh /entrypoint.sh
# COPY /opt/dev-purebliss/services/grafana/scripts/ /opt/scripts/ 2>/dev/null || true


# Phase 4: Advanced Features
FROM phase3 AS phase4
# COPY /opt/dev-purebliss/services/grafana/templates/ /opt/templates/ 2>/dev/null || true
# COPY /opt/dev-purebliss/services/grafana/*.sh /opt/scripts/ 2>/dev/null || true
# RUN chmod +x /opt/scripts/*.sh 2>/dev/null || true


# Phase 5: Production Readiness
FROM phase4 AS phase5
# RUN mkdir -p /opt/my-secure-ha-stack/logs
# COPY /opt/dev-purebliss/services/grafana/best-practices/ /opt/best-practices/ 2>/dev/null || true


# Phase 6: Elite Features (Full existing functionality)
FROM phase5 AS phase6
# Copy all service files into /opt/grafana-config (ignore errors if already present)
COPY . /opt/grafana-config/
ENV ADVANCED_MONITORING=true
ENV AUTO_HEALING=true

# Final stage selection based on BUILD_PHASE
FROM phase${BUILD_PHASE} AS final
ENTRYPOINT ["/entrypoint.sh"]
