# --- Phase 1: Minimal container for health validation ---
FROM quay.io/keycloak/keycloak:24.0.5 AS phase1
USER root
RUN echo -e '#!/bin/bash\necho "Phase 1 minimal container starting..."\nwhile true; do\n  echo "Phase 1 healthy at $(date)"\n  sleep 30\ndone' > /minimal-entrypoint.sh && chmod +x /minimal-entrypoint.sh
USER 1000
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=2 CMD ["sh", "-c", "echo 'Health check passed'"]
ENTRYPOINT ["/minimal-entrypoint.sh"]

# --- Phase 2+: Full Keycloak configuration ---
FROM quay.io/keycloak/keycloak:24.0.5 AS phase2
USER root
# curl is already present in the base image; no package manager available
USER 1000
ENV KC_DB=postgres
ENV KC_DB_URL_HOST=purebliss-postgres
ENV KC_DB_URL_PORT=5432
ENV KC_DB_USERNAME=keycloak
ENV KC_DB_PASSWORD=keycloak_secure_password
ENV KC_DB_SCHEMA=public
ENV KC_CACHE=ispn
# KC_CACHE_STACK=redis and Redis cache envs removed for Keycloak 24.0.5 compatibility
# ENV KC_CACHE_STACK=redis
# ENV KC_CACHE_REDIS_HOST=purebliss-redis
# ENV KC_CACHE_REDIS_PORT=6379
# Optionally, set KC_CACHE_STACK to a supported value (e.g., tcp) if clustering is needed:
# ENV KC_CACHE_STACK=tcp
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=5 \
  CMD (exec 3<>/dev/tcp/localhost/8080) >/dev/null 2>&1 || exit 1
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start-dev"]
