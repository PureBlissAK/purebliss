# --- Phase 5: Repeat phase4 config for progressive enhancement ---
FROM quay.io/keycloak/keycloak:24.0.5 AS phase5
USER 1000
ENV KC_DB=postgres
ENV KC_DB_URL_HOST=purebliss-postgres
ENV KC_DB_URL_PORT=5432
ENV KC_DB_USERNAME=keycloak
ENV KC_DB_PASSWORD=keycloak_secure_password
ENV KC_DB_SCHEMA=public
ENV KC_CACHE=ispn
# KC_CACHE_STACK=redis and Redis cache envs removed for Keycloak 24.0.5 compatibility
# ENV KC_CACHE_STACK=redis
# ENV KC_CACHE_REDIS_HOST=purebliss-redis
# ENV KC_CACHE_REDIS_PORT=6379
# Optionally, set KC_CACHE_STACK to a supported value (e.g., tcp) if clustering is needed:
# ENV KC_CACHE_STACK=tcp
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=5 \
  CMD (exec 3<>/dev/tcp/localhost/8080) >/dev/null 2>&1 || exit 1
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start-dev"]
