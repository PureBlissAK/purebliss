# PURE BLISS CONTAINER METADATA
# Container: purebliss-vault-agent
# Purpose: Vault API proxy and template processor for Pure Bliss services
# Scaffolding Phase: Phase3 - Core Service Integration
# Description: HashiCorp Vault Agent providing API proxy, caching, and template processing for service authentication
# Production Status: production-ready
# Dependencies: vault
# Network: purebliss-net
# Vault Integration: yes
# Last Enhanced: 2025-08-08
# Enhancement Notes: Added comprehensive metadata for improved traceability and troubleshooting
# END METADATA

FROM hashicorp/vault:1.17.3

# Install required packages for health checks and user switching
RUN apk add --no-cache curl su-exec bash

# Create directories for vault agent
RUN mkdir -p /vault/agent/output /vault/agent/logs /vault/secrets /vault/templates

# Copy our custom entrypoint script
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Set entrypoint
ENTRYPOINT ["/entrypoint.sh"]
