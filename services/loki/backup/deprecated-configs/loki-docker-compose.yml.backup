services:
  purebliss-loki:
    image: grafana/loki:2.9.0
    container_name: purebliss-loki
    restart: unless-stopped
    ports:
      - "3100:3100"
    volumes:
      - /raid-storage/loki/data:/loki
      - ${LOKI_LOG_PATH}:/var/log/loki/loki.log
      - ./local-config.yaml:/etc/loki/local-config.yaml:ro
    command: -config.file=/etc/loki/local-config.yaml
    environment:
      - VAULT_ADDR=${VAULT_ADDR:-https://purebliss-vault:8200}
      - VAULT_SKIP_VERIFY=${VAULT_SKIP_VERIFY:-1}
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:3100/ready"]
      interval: 10s
      timeout: 5s
      retries: 5
    deploy:
      resources:
        limits:
          memory: 2G
          cpus: '2.0'
        reservations:
          memory: 1G
          cpus: '1.0'
    networks:
      - purebliss-net
networks:
  purebliss-net:
    external: true
