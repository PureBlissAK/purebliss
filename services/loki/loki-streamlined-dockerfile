# Streamlined Loki Dockerfile - Pure Bliss Elite Standards
# Addresses: ENTRYPOINT override, config usage, auto-executable permissions

FROM grafana/loki:2.9.0

# Pure Bliss Elite Standards
LABEL maintainer="Pure Bliss Elite Development"
LABEL service="loki"
LABEL version="2.9.0-streamlined"

# Install essential utilities only
USER root
RUN apk add --no-cache curl bash

# Create directories and copy files
RUN mkdir -p /etc/loki /loki/data /loki/chunks
COPY local-config.yaml /etc/loki/local-config.yaml
COPY entrypoint-enhanced.sh /usr/local/bin/entrypoint-enhanced.sh

# Set proper permissions (auto-executable enhancement)
RUN chmod +x /usr/local/bin/entrypoint-enhanced.sh \
    && chown -R loki:loki /loki /etc/loki

# Switch to loki user for security
USER loki
WORKDIR /loki

# Expose port
EXPOSE 3100

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3100/ready || exit 1

# CRITICAL: Override ENTRYPOINT to ensure config file usage
# This resolves the root cause from previous issues
ENTRYPOINT ["/usr/local/bin/entrypoint-enhanced.sh"]
