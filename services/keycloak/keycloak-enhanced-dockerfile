# Enhanced Keycloak Dockerfile with Pure Bliss Integration
# Supports Vault integration and PostgreSQL backend


# --- Stage 1: Download Vault binary ---
FROM alpine:3.19 AS builder
RUN apk add --no-cache curl unzip netcat-openbsd \
    && curl -sL https://releases.hashicorp.com/vault/1.15.2/vault_1.15.2_linux_amd64.zip -o vault.zip \
    && unzip vault.zip \
    && chmod +x vault

# --- Stage 2: Keycloak with Vault integration ---

FROM quay.io/keycloak/keycloak:24.0.5



# Copy Vault binary from builder
USER 0
COPY --from=builder /vault /usr/local/bin/vault
    # Install curl in a UBI9 build stage and copy it into the final image
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest AS ubi9curl
RUN microdnf install -y curl-minimal krb5-libs keyutils-libs && microdnf clean all

    FROM quay.io/keycloak/keycloak:24.0.5 AS final
    USER 0
    COPY --from=builder /vault /usr/local/bin/vault
    COPY --from=ubi9curl /usr/bin/curl /usr/bin/curl
    COPY --from=ubi9curl /lib64/libcurl.so.4 /lib64/
    COPY --from=ubi9curl /lib64/libnghttp2.so.14 /lib64/
    COPY --from=ubi9curl /lib64/libidn2.so.0 /lib64/
    COPY --from=ubi9curl /lib64/libssl.so.3 /lib64/
    COPY --from=ubi9curl /lib64/libcrypto.so.3 /lib64/
    COPY --from=ubi9curl /lib64/libz.so.1 /lib64/
    COPY --from=ubi9curl /lib64/libgssapi_krb5.so.2 /lib64/
    COPY --from=ubi9curl /lib64/libgssapi_krb5.so.2.2 /lib64/
    COPY --from=ubi9curl /lib64/libkrb5.so.3 /lib64/
    COPY --from=ubi9curl /lib64/libkrb5.so.3.3 /lib64/
    COPY --from=ubi9curl /lib64/libk5crypto.so.3 /lib64/
    COPY --from=ubi9curl /lib64/libk5crypto.so.3.1 /lib64/
    COPY --from=ubi9curl /lib64/libcom_err.so.2 /lib64/
    COPY --from=ubi9curl /lib64/libcom_err.so.2.1 /lib64/
    COPY --from=ubi9curl /lib64/libkrb5support.so.0 /lib64/
    COPY --from=ubi9curl /lib64/libkrb5support.so.0.1 /lib64/
    COPY --from=ubi9curl /lib64/libkeyutils.so.1 /lib64/
    COPY --from=ubi9curl /lib64/libresolv.so.2 /lib64/
    COPY --from=ubi9curl /lib64/libselinux.so.1 /lib64/
    COPY --from=ubi9curl /lib64/libpcre2-8.so.0 /lib64/
    RUN mkdir -p /opt/my-secure-ha-stack/logs /opt/scripts

# Copy enhanced entrypoint script
COPY entrypoint.sh /opt/keycloak/bin/enhanced-entrypoint.sh
RUN chmod +x /opt/keycloak/bin/enhanced-entrypoint.sh

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD /usr/bin/curl -f http://localhost:8080/health/ready || exit 1

# Environment variables for Pure Bliss integration
ENV VAULT_ADDR=https://purebliss-vault:8200 \
    VAULT_SKIP_VERIFY=true \
    USE_VAULT=true \
    KC_DB=postgres \
    KC_DB_URL=jdbc:postgresql://purebliss-postgres:5432/keycloak \
    KC_PROXY=edge \
    KC_HOSTNAME_STRICT=false \
    KC_HTTP_ENABLED=true

# Switch back to keycloak user
USER 1000

# Expose Keycloak port
EXPOSE 8080

# Use enhanced entrypoint
ENTRYPOINT ["/opt/keycloak/bin/enhanced-entrypoint.sh"]
