services:
  vault-agent:
    build:
      context: .
      dockerfile: vault-agent-dockerfile
    container_name: purebliss-vault-agent
    volumes:
      - ./vault-agent/config.hcl:/etc/vault-agent/config.hcl:ro
      - ./vault-agent:/vault/agent:rw
    env_file:
      - /opt/my-secure-ha-stack/config.env
    networks:
      - purebliss-net
    healthcheck:
      test: ["CMD", "vault", "status"]
      interval: 30s
      timeout: 10s
      retries: 3
networks:
  purebliss-net:
    external: true
