# Enhanced Nginx Dockerfile with Vault CLI and SSL/TLS automation
# Supports independent container startup with comprehensive certificate management

FROM nginx:latest

# Install dependencies for Vault integration and SSL certificate management
RUN apt-get update && apt-get install -y \
    wget \
    unzip \
    curl \
    jq \
    openssl \
    ca-certificates \
    bash \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create nginx user and group if they don't exist
RUN groupadd -r nginx || true && \
    useradd -r -g nginx nginx || true

# Remove default configuration
RUN rm -f /etc/nginx/conf.d/default.conf

# Create necessary directories with proper permissions
RUN mkdir -p /etc/nginx/certs \
             /etc/nginx/conf.d \
             /var/log/nginx \
             /usr/share/nginx/html \
             /opt/my-secure-ha-stack/logs \
    && touch /var/log/nginx/access.log /var/log/nginx/error.log \
    && chown -R nginx:nginx /etc/nginx/certs \
                            /var/log/nginx \
                            /usr/share/nginx/html \
    && chmod 755 /etc/nginx/certs

# Copy enhanced entrypoint script with smart upstream logic
COPY entrypoint-enhanced.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Create basic index page
RUN echo '<html><head><title>Pure Bliss Gateway</title></head><body><h1>Pure Bliss Development Gateway</h1><p>SSL/TLS enabled with Vault PKI integration</p></body></html>' > /usr/share/nginx/html/index.html

# Copy config.env for environment propagation
COPY config.env /opt/my-secure-ha-stack/config.env

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:80/health || curl -fk https://localhost:443/health || exit 1

# Environment variables
ENV VAULT_ADDR=https://127.0.0.1:8200 \
    VAULT_SKIP_VERIFY=true \
    DOMAIN=dev.purebliss.app \
    USE_VAULT=true

# Expose HTTP and HTTPS ports
EXPOSE 80 443

# Use custom entrypoint
ENTRYPOINT ["/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
