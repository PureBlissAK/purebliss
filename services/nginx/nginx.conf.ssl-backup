# Nginx Configuration with Vault PKI Integration
# Optimized for Pure Bliss Microservices Architecture

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log notice;
pid /var/run/nginx.pid;

# Optimize for high concurrency
worker_rlimit_nofile 65535;

events {
    worker_connections 2048;
    use epoll;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Logging format
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    # Performance optimizations
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    client_max_body_size 100M;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        application/atom+xml
        application/geo+json
        application/javascript
        application/x-javascript
        application/json
        application/ld+json
        application/manifest+json
        application/rdf+xml
        application/rss+xml
        application/xhtml+xml
        application/xml
        font/eot
        font/otf
        font/ttf
        image/svg+xml
        text/css
        text/javascript
        text/plain
        text/xml;

    # Rate limiting
    limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=login:10m rate=1r/s;

    # SSL/TLS Configuration
    ssl_certificate /etc/nginx/certs/live/dev.purebliss.app/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/live/dev.purebliss.app/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    # Security: HTTP Strict Transport Security
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    # Pure Bliss Services Configuration (Minimal for Current Setup)
    # Only include services that are currently running: vault, vault-agent, postgres, redis
    
    # Vault service (running on port 8200)
    upstream vault {
        server purebliss-vault:8200 max_fails=3 fail_timeout=10s;
    }

    # For build validation: Comment out non-running services
    # upstream codeserver {
    #     # For build validation: use localhost as primary, comment out non-resolvable host
    #     server 127.0.0.1:8080;
    #     # server purebliss-codeserver:8080 max_fails=3 fail_timeout=10s; # Enable in production
    # }

    # upstream keycloak {
    #     # For build validation: use localhost as primary, comment out non-resolvable host
    #     server 127.0.0.1:8080;
    #     # server purebliss-keycloak:8080; # Enable in production
    # }

    # upstream plane {
    #     # For build validation: use localhost as primary, comment out non-resolvable host
    #     server 127.0.0.1:3000;
    #     # server purebliss-plane:3000; # Enable in production
    # }

    # upstream grafana {
    #     # For build validation: use localhost as primary, comment out non-resolvable host
    #     server 127.0.0.1:3000;
    #     # server purebliss-grafana:3000; # Enable in production
    # }

    # upstream prometheus {
    #     # For build validation: use localhost as primary, comment out non-resolvable host
    #     server 127.0.0.1:9090;
    #     # server purebliss-prometheus:9090; # Enable in production
    # }

    # HTTPS Server
    server {
        listen 443 ssl http2;
        listen [::]:443 ssl http2;
        server_name dev.purebliss.app *.dev.purebliss.app;

        # SSL/TLS settings
        ssl_certificate /etc/nginx/certs/live/dev.purebliss.app/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/live/dev.purebliss.app/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
        # Security headers
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer-when-downgrade" always;
        add_header Content-Security-Policy "default-src 'self' http: https: data: blob: 'unsafe-inline'" always;
        # HTTP Strict Transport Security
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

        # Vault API proxy (only running service route currently enabled)
        location /vault/ {
            proxy_pass http://vault/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # CodeServer (disabled - service not running)
        # location /code-server/ {
        #     proxy_pass http://codeserver/;
        #     proxy_http_version 1.1;
        #     proxy_set_header Upgrade $http_upgrade;
        #     proxy_set_header Connection "upgrade";
        #     proxy_set_header Host $host;
        #     proxy_set_header X-Real-IP $remote_addr;
        #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        #     proxy_set_header X-Forwarded-Proto $scheme;
        #     proxy_read_timeout 86400;
        # }

        # Keycloak (disabled - service not running)
        # location /keycloak/ {
        #     limit_req zone=login burst=5 nodelay;
        #     proxy_pass http://keycloak/;
        #     proxy_set_header Host $host;
        #     proxy_set_header X-Real-IP $remote_addr;
        #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        #     proxy_set_header X-Forwarded-Proto $scheme;
        # }

        # Plane (disabled - service not running)
        # location /plane/ {
        #     limit_req zone=api burst=20 nodelay;
        #     proxy_pass http://plane/;
        #     proxy_set_header Host $host;
        #     proxy_set_header X-Real-IP $remote_addr;
        #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        #     proxy_set_header X-Forwarded-Proto $scheme;
        # }

        # Grafana (disabled - service not running)
        # location /grafana/ {
        #     proxy_pass http://grafana/;
        #     proxy_set_header Host $host;
        #     proxy_set_header X-Real-IP $remote_addr;
        #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        #     proxy_set_header X-Forwarded-Proto $scheme;
        # }

        # Prometheus (disabled - service not running)
        # location /prometheus/ {
        #     limit_req zone=api burst=10 nodelay;
        #     proxy_pass http://prometheus/;
        #     proxy_set_header Host $host;
        #     proxy_set_header X-Real-IP $remote_addr;
        #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        #     proxy_set_header X-Forwarded-Proto $scheme;
        # }

        # Health check endpoint
        location /health {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
            add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
        }

        # Default location (redirect to health check since code-server is not running)
        location / {
            add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
            return 301 https://$server_name/health;
        }
    }

    # HTTP to HTTPS redirect
    server {
        listen 80;
        listen [::]:80;
        server_name dev.purebliss.app *.dev.purebliss.app;
        return 301 https://$server_name$request_uri;
    }
}
