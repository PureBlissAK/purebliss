# Nginx Configuration with Vault PKI Integration
# Optimized for Pure Bliss Microservices Architecture

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log notice;
pid /var/run/nginx.pid;

# Optimize for high concurrency
worker_rlimit_nofile 65535;

events {
    worker_connections 2048;
    use epoll;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Logging format
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    # Performance optimizations
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    client_max_body_size 100M;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        application/atom+xml
        application/geo+json
        application/javascript
        application/x-javascript
        application/json
        application/ld+json
        application/manifest+json
        application/rdf+xml
        application/rss+xml
        application/xhtml+xml
        application/xml
        font/eot
        font/otf
        font/ttf
        image/svg+xml
        text/css
        text/javascript
        text/plain
        text/xml;

    # Rate limiting
    limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=login:10m rate=1r/s;

    # SSL/TLS Configuration
    ssl_certificate /etc/nginx/certs/live/dev.purebliss.app/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/live/dev.purebliss.app/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    # Security: HTTP Strict Transport Security
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    # Pure Bliss Services Configuration
    # Using resolver for dynamic upstream resolution
    resolver 127.0.0.11 valid=30s ipv6=off;

    # HTTPS Server
    server {
        listen 443 ssl http2;
        listen [::]:443 ssl http2;
        server_name dev.purebliss.app *.dev.purebliss.app;

        # SSL/TLS settings
        ssl_certificate /etc/nginx/certs/live/dev.purebliss.app/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/live/dev.purebliss.app/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
        
        # Security headers (applied to all locations)
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer-when-downgrade" always;
        add_header Content-Security-Policy "default-src 'self' http: https: data: blob: 'unsafe-inline'" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

                # CodeServer
        location /code-server/ {
            # Use dynamic upstream resolution
            set $upstream_codeserver "purebliss-codeserver:8080";
            
            # Error handling for upstream unavailability
            error_page 502 503 504 = @codeserver_unavailable;
            
            proxy_pass http://$upstream_codeserver/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 86400;
            proxy_connect_timeout 5s;
            proxy_send_timeout 10s;
        }

        # Keycloak
        location /keycloak/ {
            set $upstream_keycloak "purebliss-keycloak:8080";
            error_page 502 503 504 = @keycloak_unavailable;
            
            limit_req zone=login burst=5 nodelay;
            proxy_pass http://$upstream_keycloak/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 5s;
            proxy_send_timeout 10s;
        }

        # Plane
        location /plane/ {
            set $upstream_plane "purebliss-plane:3000";
            error_page 502 503 504 = @plane_unavailable;
            
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://$upstream_plane/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 5s;
            proxy_send_timeout 10s;
        }

        # Grafana
        location /grafana/ {
            set $upstream_grafana "purebliss-grafana:3000";
            error_page 502 503 504 = @grafana_unavailable;
            
            proxy_pass http://$upstream_grafana/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 5s;
            proxy_send_timeout 10s;
        }

        # Prometheus
        location /prometheus/ {
            set $upstream_prometheus "purebliss-prometheus:9090";
            error_page 502 503 504 = @prometheus_unavailable;
            
            limit_req zone=api burst=10 nodelay;
            proxy_pass http://$upstream_prometheus/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 5s;
            proxy_send_timeout 10s;
        }


        # Plane
        location /plane/ {
            set $upstream_plane "purebliss-plane:3000";
            error_page 502 503 504 = @plane_unavailable;
            
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://$upstream_plane/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 5s;
            proxy_send_timeout 10s;
        }

        # Grafana
            
            limit_req zone=api burst=10 nodelay;
            proxy_pass http://$upstream_prometheus/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 5s;
            proxy_send_timeout 10s;
        }

                # Vault (HTTPS when ready)
        location /vault/ {
            set $upstream_vault "purebliss-vault:8200";
            error_page 502 503 504 = @vault_unavailable;
            
            # Uncomment when Vault is SSL-ready
            # limit_req zone=api burst=5 nodelay;
            # proxy_pass http://vault/;
            # proxy_set_header Host $host;
            # proxy_set_header X-Real-IP $remote_addr;
            # proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            # proxy_set_header X-Forwarded-Proto $scheme;
            # proxy_connect_timeout 5s;
            # proxy_send_timeout 10s;
            return 503 '{"service": "vault", "status": "https_not_configured", "message": "Vault HTTPS not configured yet. Use HTTP endpoint.", "redirect": "http://dev.purebliss.app/vault/"}';
            add_header Content-Type application/json;
        }

        # Loki (HTTPS when ready)
        location /loki/ {
            set $upstream_loki "purebliss-loki:3100";
            error_page 502 503 504 = @loki_unavailable;
            
            # Uncomment when Loki is SSL-ready
            # limit_req zone=api burst=10 nodelay;
            # proxy_pass http://loki/;
            # proxy_set_header Host $host;
            # proxy_set_header X-Real-IP $remote_addr;
            # proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            # proxy_set_header X-Forwarded-Proto $scheme;
            # proxy_connect_timeout 5s;
            # proxy_send_timeout 10s;
            return 503 '{"service": "loki", "status": "https_not_configured", "message": "Loki HTTPS not configured yet. Use HTTP endpoint.", "redirect": "http://dev.purebliss.app/loki/"}';
            add_header Content-Type application/json;
        }

        # Health check endpoint
        location /health {
            access_log off;
            add_header Content-Type text/plain;
            return 200 "healthy\n";
        }

        # Default location
        location / {
            add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
            return 301 https://$server_name/code-server/;
        }

        # Error handlers for unavailable services
        location @codeserver_unavailable {
            return 503 '{"service": "code-server", "status": "unavailable", "message": "CodeServer is starting up. Please try again in a few moments.", "retry_after": 30}';
            add_header Content-Type application/json;
            add_header Retry-After 30;
        }

        location @keycloak_unavailable {
            return 503 '{"service": "keycloak", "status": "unavailable", "message": "Keycloak authentication service is starting up. Please try again in a few moments.", "retry_after": 30}';
            add_header Content-Type application/json;
            add_header Retry-After 30;
        }

        location @plane_unavailable {
            return 503 '{"service": "plane", "status": "unavailable", "message": "Plane issue tracking service is starting up. Please try again in a few moments.", "retry_after": 30}';
            add_header Content-Type application/json;
            add_header Retry-After 30;
        }

        location @grafana_unavailable {
            return 503 '{"service": "grafana", "status": "unavailable", "message": "Grafana monitoring service is starting up. Please try again in a few moments.", "retry_after": 30}';
            add_header Content-Type application/json;
            add_header Retry-After 30;
        }

        location @prometheus_unavailable {
            return 503 '{"service": "prometheus", "status": "unavailable", "message": "Prometheus metrics service is starting up. Please try again in a few moments.", "retry_after": 30}';
            add_header Content-Type application/json;
            add_header Retry-After 30;
        }

        location @vault_unavailable {
            return 503 '{"service": "vault", "status": "unavailable", "message": "Vault secrets service is starting up. Please try again in a few moments.", "retry_after": 30}';
            add_header Content-Type application/json;
            add_header Retry-After 30;
        }

        location @loki_unavailable {
            return 503 '{"service": "loki", "status": "unavailable", "message": "Loki logging service is starting up. Please try again in a few moments.", "retry_after": 30}';
            add_header Content-Type application/json;
            add_header Retry-After 30;
        }
    }

    # HTTP to HTTPS redirect (selective for SSL-ready services)
    server {
        listen 80;
        listen [::]:80;
        server_name dev.purebliss.app *.dev.purebliss.app;

                # Vault - Allow HTTP access (not SSL-ready)
        location /vault/ {
            set $upstream_vault "purebliss-vault:8200";
            error_page 502 503 504 = @vault_http_unavailable;
            
            proxy_pass http://$upstream_vault/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 5s;
            proxy_send_timeout 10s;
        }

        # Loki - Allow HTTP access (monitoring service)
        location /loki/ {
            set $upstream_loki "purebliss-loki:3100";
            error_page 502 503 504 = @loki_http_unavailable;
            
            proxy_pass http://$upstream_loki/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 5s;
            proxy_send_timeout 10s;
        }

        # Health check endpoint (HTTP)
        location /health {
            access_log off;
            return 200 "healthy
";
            add_header Content-Type text/plain;
        }

        # Error handlers for HTTP services
        location @vault_http_unavailable {
            return 503 '{"service": "vault", "protocol": "http", "status": "unavailable", "message": "Vault service is starting up. Please try again in a few moments.", "retry_after": 30}';
            add_header Content-Type application/json;
            add_header Retry-After 30;
        }

        location @loki_http_unavailable {
            return 503 '{"service": "loki", "protocol": "http", "status": "unavailable", "message": "Loki service is starting up. Please try again in a few moments.", "retry_after": 30}';
            add_header Content-Type application/json;
            add_header Retry-After 30;
        }

        # Redirect all other HTTP traffic to HTTPS
        location / {
            return 301 https://$server_name$request_uri;
        }
    }
}
