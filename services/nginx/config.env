# Pure Bliss Development Environment - Centralized Environment Variables
#
# This file centralizes environment variables for orchestration and service configuration
# in the Pure Bliss ecosystem. It supports independent container startup and complies with
# the standards in /opt/my-secure-ha-stack/docs/copilot-instructions.md.
#
# Guidelines:
# - Do not hardcode sensitive data (e.g., passwords, tokens); use Vault for secrets.
# - Update values as needed for your deployment, ensuring compatibility with Docker Compose v3.8.
# - All services must log actions to /opt/my-secure-ha-stack/logs/dev-environment-setup.log.
# - Variables are used by service-specific entrypoint.sh scripts for standalone operation.

# =========================
# General Configuration
# =========================
ENVIRONMENT=development
LOCAL_HOSTNAME=dev.purebliss.app
DOMAIN=dev.purebliss.app
NETWORK_NAME=purebliss-net
LOG_LEVEL=DEBUG
LOG_BASE_PATH=${RAID_STORAGE}/logs
LOG_PATH=${LOG_BASE_PATH}/dev-environment-setup.log

# =========================
# RAID Storage Validation & Monitoring
# =========================
# RAID storage validation is mandatory for all services
RAID_VALIDATION_ENABLED=true
RAID_HEALTH_CHECK_INTERVAL=300  # seconds
RAID_MIN_FREE_SPACE_GB=10  # Minimum free space required
RAID_BACKUP_RETENTION_DAYS=30  # Backup retention period

RAID_LOGS_PATH=${RAID_STORAGE}/logs
RAID_HEALTH_LOG=${RAID_LOGS_PATH}/raid-health.log
RAID_USAGE_LOG=${RAID_LOGS_PATH}/raid-usage.log

# =========================
# Docker Operation Standards
# =========================
# Enhanced Docker command safety for automation
DOCKER_EXEC_TIMEOUT=30  # Default timeout for Docker exec commands
DOCKER_HEALTH_CHECK_TIMEOUT=10  # Health check timeout
DOCKER_RESTART_POLICY=unless-stopped  # Restart policy for all containers
DOCKER_LOG_DRIVER=json-file  # Log driver for container logs
DOCKER_LOG_MAX_SIZE=10m  # Maximum log file size
DOCKER_LOG_MAX_FILE=3  # Maximum number of log files
DOCKER_RESOURCE_LIMITS_ENABLED=true  # Enable resource limits for all containers
DOCKER_MEMORY_LIMIT=2g  # Default memory limit per container
DOCKER_CPU_LIMIT=4.0  # Default CPU limit per container
DOCKER_NETWORK_MODE=bridge  # Network mode for containers
DOCKER_SECURITY_OPT="no-new-privileges:true"  # Security options

# =========================
# Service Health Check Configuration
# =========================
# Health check intervals and timeouts for all services
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=60s
HEALTH_CHECK_FAILURE_THRESHOLD=5  # Failures before marking unhealthy
HEALTH_CHECK_SUCCESS_THRESHOLD=2  # Successes before marking healthy
HEALTH_CHECK_LOG_PATH=${RAID_STORAGE}/logs/health-checks.log

# =========================
# Observability & SRE Standards
# =========================
# SLA/SLO/SLI Definitions for each microservice
AVAILABILITY_TARGET=99.95  # Target availability percentage
LATENCY_P99_TARGET=200  # P99 latency target in milliseconds
ERROR_RATE_TARGET=0.1  # Error rate target percentage
SLO_VIOLATION_LOG_PATH=${RAID_STORAGE}/logs/slo-violations.log
SLO_EVALUATION_INTERVAL=300  # SLO evaluation interval in seconds

# Chaos Engineering Configuration
CHAOS_ENGINEERING_ENABLED=false  # Enable in staging/testing environments
CHAOS_PROBABILITY=0.01  # Probability of chaos injection (1%)
CHAOS_LATENCY_MIN_MS=100  # Minimum chaos latency injection
CHAOS_LATENCY_MAX_MS=500  # Maximum chaos latency injection
CHAOS_LOG_PATH=${RAID_STORAGE}/logs/chaos-engineering.log

# Performance Testing Configuration
LOAD_TEST_USERS=100  # Default number of concurrent users for load testing
LOAD_TEST_DURATION=300s  # Default load test duration
LOAD_TEST_RAMP_UP_TIME=60s  # Time to ramp up to full load
PERFORMANCE_LOG_PATH=${RAID_STORAGE}/logs/performance-tests.log
PERFORMANCE_BASELINE_PATH=${RAID_STORAGE}/logs/performance-baselines.json

# Capacity Planning Thresholds
CPU_THRESHOLD=80  # CPU utilization alert threshold percentage
MEMORY_THRESHOLD=85  # Memory utilization alert threshold percentage
DISK_THRESHOLD=90  # Disk utilization alert threshold percentage
NETWORK_THRESHOLD=70  # Network utilization alert threshold percentage
CAPACITY_PLANNING_LOG_PATH=${RAID_STORAGE}/logs/capacity-planning.log

# =========================
# Resilience Patterns Configuration
# =========================
# Circuit Breaker Implementation
CIRCUIT_BREAKER_ENABLED=true  # Enable circuit breaker pattern
CIRCUIT_BREAKER_THRESHOLD=5  # Failure threshold to open circuit
CIRCUIT_BREAKER_TIMEOUT=60  # Timeout before attempting half-open state
CIRCUIT_BREAKER_RESET_TIMEOUT=300  # Time before resetting failure count
CIRCUIT_BREAKER_LOG_PATH=${RAID_STORAGE}/logs/circuit-breaker.log

# Bulkhead Pattern Configuration
DB_THREAD_POOL_SIZE=10  # Database connection pool size
API_THREAD_POOL_SIZE=20  # API request thread pool size
BG_THREAD_POOL_SIZE=5  # Background task thread pool size
THREAD_POOL_QUEUE_SIZE=100  # Maximum queue size for thread pools

# Retry Configuration with Exponential Backoff
MAX_RETRY_ATTEMPTS=3  # Maximum number of retry attempts
BASE_DELAY_MS=100  # Base delay for exponential backoff
MAX_DELAY_MS=5000  # Maximum delay for exponential backoff
RETRY_JITTER_ENABLED=true  # Enable jitter to prevent thundering herd

# Graceful Degradation Configuration
DEGRADED_MODE_ENABLED=true  # Enable graceful degradation
DEGRADED_MODE_FEATURES="advanced_analytics,non_critical_notifications,background_sync"  # Features to disable during degradation
DEGRADATION_LOG_PATH=${RAID_STORAGE}/logs/service-degradation.log

# =========================
# Development Environment Configuration
# =========================
# Enhanced development and debugging settings
DEBUG_MODE=true  # Enable debug logging for development
DEV_SKIP_VAULT_VALIDATION=false  # Skip Vault validation in development
DEV_ALLOW_HTTP=true  # Allow HTTP in development environment
DEV_MOCK_EXTERNAL_SERVICES=false  # Mock external service dependencies
DEV_PERFORMANCE_PROFILING=true  # Enable performance profiling in development
DEV_TRACE_REQUESTS=true  # Enable request tracing in development

# =========================
# Security Hardening Configuration
# =========================
# Zero Trust Architecture
ZERO_TRUST_ENABLED=true  # Enable zero trust validation
ZERO_TRUST_VERIFY_IDENTITY=true  # Verify user identity for all requests
ZERO_TRUST_VALIDATE_DEVICE=true  # Validate device fingerprints
ZERO_TRUST_LEAST_PRIVILEGE=true  # Enforce least privilege access
ZERO_TRUST_MONITOR_CONTINUOUSLY=true  # Enable continuous monitoring
ZERO_TRUST_LOG_PATH=${RAID_STORAGE}/logs/zero-trust-access.log

# Supply Chain Security
SBOM_GENERATION_ENABLED=true  # Enable Software Bill of Materials generation
SBOM_FORMAT=spdx-json  # SBOM format (spdx-json, cyclonedx-json)
SBOM_OUTPUT_PATH=${RAID_STORAGE}/logs/sbom  # SBOM output directory
VULNERABILITY_SCANNING_ENABLED=true  # Enable vulnerability scanning
VULNERABILITY_SCAN_PATH=${RAID_STORAGE}/logs/vulnerability-scans  # Vulnerability scan results
VULNERABILITY_SCAN_SCHEDULE="0 2 * * *"  # Daily vulnerability scan schedule

# Runtime Security
RUNTIME_SECURITY_ENABLED=true  # Enable runtime security monitoring
FILE_INTEGRITY_MONITORING=true  # Monitor critical file changes
SECURITY_LOG_PATH=${RAID_STORAGE}/logs/runtime-security.log
SECURITY_SCAN_INTERVAL=3600  # Security scan interval in seconds
SECURITY_ALERT_THRESHOLD=10  # Number of security events before alerting

# Compliance Frameworks
COMPLIANCE_FRAMEWORKS=SOC2,GDPR,HIPAA  # Enabled compliance frameworks
AUDIT_LOG_PATH=${RAID_STORAGE}/logs/compliance-audit.log
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years retention for compliance
AUDIT_LOG_ENCRYPTION_ENABLED=true  # Encrypt audit logs at rest
PII_DATA_CLASSIFICATION=true  # Enable PII data classification
DATA_RETENTION_POLICY_ENABLED=true  # Enable automated data retention policies

# =========================
# Persistent Storage Paths (RAID)
# =========================
# All stateful service data and logs are stored on a RAID device for durability.
RAID_STORAGE=/raid-storage

DATA_BASE_PATH=${RAID_STORAGE}
CODESERVER_DATA_PATH=${DATA_BASE_PATH}/codeserver/data
GRAFANA_DATA_PATH=${DATA_BASE_PATH}/grafana/data
LETSENCRYPT_DATA_PATH=${DATA_BASE_PATH}/letsencrypt
LOKI_DATA_PATH=${DATA_BASE_PATH}/loki/data
NGINX_SSL_CERT_PATH=${DATA_BASE_PATH}/nginx/certs
PLANE_DATA_PATH=${DATA_BASE_PATH}/plane/data
POSTGRES_DATA_PATH=${DATA_BASE_PATH}/postgres/data
PROMETHEUS_DATA_PATH=${DATA_BASE_PATH}/prometheus/data
REDIS_DATA_PATH=${DATA_BASE_PATH}/redis/data
VAULT_DATA_PATH=${DATA_BASE_PATH}/vault/data
VIKUNJA_DATA_PATH=${DATA_BASE_PATH}/vikunja/data

# Service Log Paths
CODESERVER_LOG_PATH=${RAID_LOGS_PATH}/code-server.log
GRAFANA_LOG_PATH=${RAID_LOGS_PATH}/grafana.log
LOKI_LOG_PATH=${RAID_LOGS_PATH}/loki.log
NGINX_LOG_PATH=${RAID_LOGS_PATH}/nginx.log
PLANE_LOG_PATH=${RAID_LOGS_PATH}/plane.log
POSTGRES_LOG_PATH=${RAID_LOGS_PATH}/postgres.log
PROMETHEUS_LOG_PATH=${RAID_LOGS_PATH}/prometheus.log
REDIS_LOG_PATH=${RAID_LOGS_PATH}/redis.log
VAULT_LOG_PATH=${RAID_LOGS_PATH}/vault.log
VAULT_AGENT_LOG_PATH=${RAID_LOGS_PATH}/vault-agent.log
VIKUNJA_LOG_PATH=${RAID_LOGS_PATH}/vikunja.log

# Backup Path
BACKUP_PATH=${DATA_BASE_PATH}/backups

# =========================
# HTTPS / SSL / TLS Defaults
# =========================
# Applied to all web-facing services (e.g., Nginx, Keycloak, Plane, Grafana).
ENABLE_HTTPS=true
SSL_CERT_PATH=${NGINX_SSL_CERT_PATH}/fullchain.pem
SSL_KEY_PATH=${NGINX_SSL_CERT_PATH}/privkey.pem
SSL_CA_PATH=${NGINX_SSL_CERT_PATH}/chain.pem
SSL_BASE_PATH=${NGINX_SSL_CERT_PATH}
TLS_VERSION=TLSv1.3
SSL_CIPHERS=ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305
HSTS_HEADER="max-age=63072000; includeSubDomains; preload"
FORCE_HTTPS_REDIRECT=true

# =========================
# Vault Configuration
# =========================
# Vault is used for all secrets management. Avoid hardcoding sensitive data.
VAULT_ADDR=https://purebliss-vault:8200
VAULT_TOKEN=  # Admin token, populated by setup scripts or Vault admin
VAULT_UNSEAL_KEY_1=  # Unseal keys for Vault, set during initialization
VAULT_UNSEAL_KEY_2=
VAULT_UNSEAL_KEY_3=
VAULT_TLS_PATH=${RAID_STORAGE}/vault/tls
VAULT_BASE_PATH=/opt/dev-purebliss/services/vault/vault-agent
VAULT_AGENT_CONFIG_PATH=${VAULT_BASE_PATH}/config.hcl
VAULT_AGENT_ROLE_ID_PATH=${VAULT_BASE_PATH}/role_id
VAULT_AGENT_SECRET_ID_PATH=${VAULT_BASE_PATH}/secret_id
VAULT_AGENT_TEMPLATES_PATH=${VAULT_BASE_PATH}/
VAULT_AGENT_OUTPUT_PATH=${VAULT_BASE_PATH}/
# Development mode flag for standalone container operation
VAULT_DEV_MODE=false  # Set to true to bypass Vault for development
# Enhanced Vault Configuration
VAULT_AUTO_UNSEAL_ENABLED=false  # Enable auto-unseal with cloud KMS
VAULT_SEAL_TYPE=shamir  # Seal type: shamir, gcpckms, awskms, azurekeyvault
VAULT_HIGH_AVAILABILITY=false  # Enable HA mode with Raft storage
VAULT_AUDIT_ENABLED=true  # Enable audit logging
VAULT_AUDIT_LOG_PATH=${RAID_STORAGE}/logs/vault-audit.log
VAULT_SECRET_ROTATION_ENABLED=true  # Enable automatic secret rotation
VAULT_SECRET_ROTATION_INTERVAL=2160h  # Secret rotation interval (90 days)
VAULT_DYNAMIC_SECRETS_ENABLED=true  # Enable dynamic secrets
VAULT_PERFORMANCE_MONITORING=true  # Enable Vault performance monitoring
VAULT_BACKUP_ENABLED=true  # Enable automated Vault backups
VAULT_BACKUP_SCHEDULE="0 1 * * *"  # Daily backup schedule
VAULT_BACKUP_ENCRYPTION=true  # Encrypt backups

# =========================
# Service-Specific Vault AppRole Credentials
# =========================
# Each service uses AppRole for Vault authentication. Credentials are passed via
# environment variables or mounted files for standalone operation.
CODESERVER_VAULT_ROLE_ID=
CODESERVER_VAULT_SECRET_ID=
GRAFANA_VAULT_ROLE_ID=
GRAFANA_VAULT_SECRET_ID=
KEYCLOAK_VAULT_ROLE_ID=
KEYCLOAK_VAULT_SECRET_ID=
LOKI_VAULT_ROLE_ID=
LOKI_VAULT_SECRET_ID=
NGINX_VAULT_ROLE_ID=
NGINX_VAULT_SECRET_ID=
PLANE_VAULT_ROLE_ID=
PLANE_VAULT_SECRET_ID=
POSTGRES_VAULT_ROLE_ID=
POSTGRES_VAULT_SECRET_ID=
PROMETHEUS_VAULT_ROLE_ID=
PROMETHEUS_VAULT_SECRET_ID=
REDIS_VAULT_ROLE_ID=
REDIS_VAULT_SECRET_ID=
VIKUNJA_VAULT_ROLE_ID=
VIKUNJA_VAULT_SECRET_ID=

# =========================
# PostgreSQL Configuration
# =========================
# All services requiring a database must use this PostgreSQL instance.
POSTGRES_HOST=purebliss-postgres
POSTGRES_PORT=5432
POSTGRES_DB=purebliss_app
POSTGRES_USER=vault_admin  # Managed by Vault dynamic credentials
POSTGRES_PASSWORD=  # Populated by Vault; leave blank
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_CONNECTION_TIMEOUT=30
POSTGRES_CONNECTION_POOL_SIZE=20  # Connection pool size per service
POSTGRES_CONNECTION_POOL_MAX_IDLE=5  # Maximum idle connections
POSTGRES_CONNECTION_POOL_MAX_LIFETIME=3600  # Connection lifetime in seconds
POSTGRES_QUERY_TIMEOUT=30  # Query timeout in seconds
POSTGRES_SLOW_QUERY_THRESHOLD=1000  # Slow query threshold in milliseconds
POSTGRES_PERFORMANCE_INSIGHTS=true  # Enable performance insights
POSTGRES_BACKUP_ENABLED=true  # Enable automated backups
POSTGRES_BACKUP_SCHEDULE="0 2 * * *"  # Daily backup schedule
POSTGRES_BACKUP_RETENTION_DAYS=30  # Backup retention period

# =========================
# Redis Configuration
# =========================
# Used for caching and session storage with AOF persistence.
REDIS_HOST=purebliss-redis
REDIS_PORT=6379
REDIS_PASSWORD=  # Populated by Vault; leave blank
REDIS_AOF_ENABLED=true
REDIS_DEFAULT_TTL=3600  # Default TTL in seconds for cached data
REDIS_CONNECTION_POOL_SIZE=50  # Connection pool size
REDIS_CONNECTION_TIMEOUT=5  # Connection timeout in seconds
REDIS_READ_TIMEOUT=30  # Read timeout in seconds
REDIS_WRITE_TIMEOUT=30  # Write timeout in seconds
REDIS_MAX_MEMORY=1gb  # Maximum memory usage
REDIS_MAX_MEMORY_POLICY=allkeys-lru  # Memory eviction policy
REDIS_CLUSTER_ENABLED=false  # Enable Redis clustering
REDIS_SENTINEL_ENABLED=false  # Enable Redis Sentinel for high availability
REDIS_PERFORMANCE_MONITORING=true  # Enable performance monitoring
REDIS_SLOW_LOG_ENABLED=true  # Enable slow query logging
REDIS_SLOW_LOG_THRESHOLD=10000  # Slow query threshold in microseconds

# =========================
# Keycloak Configuration
# =========================
KEYCLOAK_HOST=purebliss-keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=planerealm
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=  # Populated by Vault; leave blank
KEYCLOAK_DATA_PATH=${RAID_STORAGE}/keycloak/data
KEYCLOAK_LOG_PATH=${RAID_STORAGE}/logs/keycloak.log
KEYCLOAK_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/keycloak
KEYCLOAK_DB_USER=keycloak  # Managed by Vault dynamic credentials
KEYCLOAK_DB_PASSWORD=  # Populated by Vault; leave blank

# =========================
# Nginx Configuration
# =========================
NGINX_HOST=purebliss-nginx
NGINX_PORT=443
NGINX_HTTP_PORT=80
NGINX_WAF_ENABLED=true
NGINX_WORKER_CONNECTIONS=2048
NGINX_CONFIG_PATH=/opt/dev-purebliss/services/nginx/conf.d
NGINX_RATE_LIMITING=true  # Enable rate limiting
NGINX_RATE_LIMIT_REQUESTS=100  # Requests per minute per IP
NGINX_RATE_LIMIT_BURST=20  # Burst limit for rate limiting
NGINX_DDoS_PROTECTION=true  # Enable DDoS protection
NGINX_GEO_BLOCKING=false  # Enable geographic blocking
NGINX_BOT_PROTECTION=true  # Enable bot protection
NGINX_REAL_IP_HEADER=X-Forwarded-For  # Header for real IP detection
NGINX_ACCESS_LOG_PATH=${RAID_STORAGE}/logs/nginx-access.log
NGINX_ERROR_LOG_PATH=${RAID_STORAGE}/logs/nginx-error.log
NGINX_SECURITY_HEADERS=true  # Enable security headers
NGINX_COMPRESSION=true  # Enable gzip compression
NGINX_CACHE_ENABLED=true  # Enable caching
NGINX_CACHE_SIZE=1g  # Cache size
NGINX_CACHE_INACTIVE=60m  # Cache inactive time

# =========================
# Plane Configuration
# =========================
PLANE_HOST=purebliss-plane
PLANE_PORT=8081
PLANE_API_URL=https://${DOMAIN}/plane
PLANE_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/plane
PLANE_DB_USER=plane  # Managed by Vault dynamic credentials
PLANE_DB_PASSWORD=  # Populated by Vault; leave blank

# =========================
# Loki Configuration
# =========================
LOKI_HOST=purebliss-loki
LOKI_PORT=3100
LOKI_LOGQL_ENDPOINT=https://${DOMAIN}/loki/api/v1/query

# =========================
# Prometheus Configuration
# =========================
PROMETHEUS_HOST=purebliss-prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_CONFIG_PATH=/opt/dev-purebliss/services/prometheus/prometheus.yml
PROMETHEUS_SCRAPE_INTERVAL=15s

# =========================
# Grafana Configuration
# =========================
GRAFANA_HOST=purebliss-grafana
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=  # Populated by Vault; leave blank

# =========================
# CodeServer Configuration
# =========================
CODESERVER_HOST=purebliss-code-server
CODESERVER_PORT=8443
CODESERVER_CONFIG_PATH=/opt/my-secure-ha-stack/.config/code-server

# =========================
# Vikunja Configuration
# =========================
VIKUNJA_HOST=purebliss-vikunja
VIKUNJA_PORT=3456
VIKUNJA_API_URL=https://${DOMAIN}/vikunja
VIKUNJA_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/vikunja
VIKUNJA_DB_USER=vikunja  # Managed by Vault dynamic credentials
VIKUNJA_DB_PASSWORD=  # Populated by Vault; leave blank

# =========================
# Let's Encrypt / Certbot Configuration
# =========================
LETSENCRYPT_EMAIL=admin@${DOMAIN}
LETSENCRYPT_DOMAINS=${DOMAIN}
LETSENCRYPT_WEBROOT_PATH=/var/www/html
LETSENCRYPT_CERT_PATH=${NGINX_SSL_CERT_PATH}/live
LETSENCRYPT_RENEW_SCRIPT=/opt/dev-purebliss/services/dev_scripts/certbot-scripts/renew-certs.sh
LETSENCRYPT_CRON_SCHEDULE="0 3 * * *"

# =========================
# Secrets Management
# =========================
# All services must use Vault for secrets management.
SECRETS_PROVIDER=vault
SECRETS_VAULT_ADDR=${VAULT_ADDR}
SECRETS_VAULT_ROLE_ID_PATH=${VAULT_AGENT_ROLE_ID_PATH}
SECRETS_VAULT_SECRET_ID_PATH=${VAULT_AGENT_SECRET_ID_PATH}
SECRETS_VAULT_TOKEN_PATH=${VAULT_AGENT_OUTPUT_PATH}/token
SECRETS_VAULT_NAMESPACE=
SECRETS_VAULT_ENGINE=kv-v2
SECRETS_VAULT_POLICY=purebliss-agent-policy

# =========================
# Service-Specific Docker Compose and Dockerfile Names
# =========================
# Consistent naming for Docker Compose and Dockerfile files.
NGINX_DOCKER_COMPOSE_FILE=nginx-docker-compose.yml
NGINX_DOCKERFILE=nginx-dockerfile
LETSENCRYPT_DOCKER_COMPOSE_FILE=letsencrypt-docker-compose.yml
LETSENCRYPT_DOCKERFILE=letsencrypt-dockerfile
VAULT_DOCKER_COMPOSE_FILE=vault-docker-compose.yml
VAULT_DOCKERFILE=vault-dockerfile
VAULT_AGENT_DOCKER_COMPOSE_FILE=vault-agent-docker-compose.yml
VAULT_AGENT_DOCKERFILE=vault-agent-dockerfile
REDIS_DOCKER_COMPOSE_FILE=redis-docker-compose.yml
REDIS_DOCKERFILE=redis-dockerfile
POSTGRES_DOCKER_COMPOSE_FILE=postgres-docker-compose.yml
POSTGRES_DOCKERFILE=postgres-dockerfile
KEYCLOAK_DOCKER_COMPOSE_FILE=keycloak-docker-compose.yml
KEYCLOAK_DOCKERFILE=keycloak-dockerfile
GRAFANA_DOCKER_COMPOSE_FILE=grafana-docker-compose.yml
GRAFANA_DOCKERFILE=grafana-dockerfile
LOKI_DOCKER_COMPOSE_FILE=loki-docker-compose.yml
LOKI_DOCKERFILE=loki-dockerfile
PROMETHEUS_DOCKER_COMPOSE_FILE=prometheus-docker-compose.yml
PROMETHEUS_DOCKERFILE=prometheus-dockerfile
PLANE_DOCKER_COMPOSE_FILE=plane-docker-compose.yml
PLANE_DOCKERFILE=plane-dockerfile
CODESERVER_DOCKER_COMPOSE_FILE=codeserver-docker-compose.yml
CODESERVER_DOCKERFILE=codeserver-dockerfile
VIKUNJA_DOCKER_COMPOSE_FILE=vikunja-docker-compose.yml
VIKUNJA_DOCKERFILE=vikunja-dockerfile

# =========================
# Service-Specific Entrypoint Scripts
# =========================
# Each service uses an entrypoint.sh for standalone initialization.
SERVICE_BASE_PATH=/opt/dev-purebliss/services
CODESERVER_ENTRYPOINT=${SERVICE_BASE_PATH}/codeserver/entrypoint.sh
GRAFANA_ENTRYPOINT=${SERVICE_BASE_PATH}/grafana/entrypoint.sh
KEYCLOAK_ENTRYPOINT=${SERVICE_BASE_PATH}/keycloak/entrypoint.sh
LOKI_ENTRYPOINT=${SERVICE_BASE_PATH}/loki/entrypoint.sh
NGINX_ENTRYPOINT=${SERVICE_BASE_PATH}/nginx/entrypoint.sh
PLANE_ENTRYPOINT=${SERVICE_BASE_PATH}/plane/entrypoint.sh
POSTGRES_ENTRYPOINT=${SERVICE_BASE_PATH}/postgres/entrypoint.sh
PROMETHEUS_ENTRYPOINT=${SERVICE_BASE_PATH}/prometheus/entrypoint.sh
REDIS_ENTRYPOINT=${SERVICE_BASE_PATH}/redis/entrypoint.sh
VAULT_ENTRYPOINT=${SERVICE_BASE_PATH}/vault/entrypoint.sh
VAULT_AGENT_ENTRYPOINT=${SERVICE_BASE_PATH}/vault/vault-agent/entrypoint.sh
VIKUNJA_ENTRYPOINT=${SERVICE_BASE_PATH}/vikunja/entrypoint.sh

# =========================
# Monitoring and Logging Integration
# =========================
# All services must integrate with Prometheus and Loki.
PROMETHEUS_ENDPOINT=https://${DOMAIN}/prometheus
LOKI_ENDPOINT=https://${DOMAIN}/loki
LOKI_LOG_LABELS=job,service,container_name
PROMETHEUS_SCRAPE_JOBS=codeserver,keycloak,nginx,plane,postgres,redis,vault,loki,prometheus,grafana,vikunja

# =========================
# Advanced Monitoring Configuration
# =========================
# Distributed Tracing
DISTRIBUTED_TRACING_ENABLED=true  # Enable distributed tracing
JAEGER_ENDPOINT=http://localhost:14268/api/traces  # Jaeger collector endpoint
TRACE_SAMPLING_RATE=0.1  # Trace sampling rate (10%)
TRACE_LOG_PATH=${RAID_STORAGE}/logs/distributed-tracing.log
SPAN_BATCH_SIZE=100  # Batch size for span export
SPAN_EXPORT_TIMEOUT=30  # Span export timeout in seconds

# Golden Signals Monitoring
GOLDEN_SIGNALS_ENABLED=true  # Enable golden signals monitoring
LATENCY_THRESHOLD=200ms  # Latency threshold for alerting
TRAFFIC_THRESHOLD=1000rps  # Traffic threshold for alerting
ERROR_THRESHOLD=0.1%  # Error rate threshold for alerting
CPU_SATURATION_THRESHOLD=80%  # CPU saturation threshold
MEMORY_SATURATION_THRESHOLD=85%  # Memory saturation threshold
DISK_SATURATION_THRESHOLD=90%  # Disk saturation threshold
GOLDEN_SIGNALS_LOG_PATH=${RAID_STORAGE}/logs/golden-signals.log

# Alert Management and Fatigue Prevention
ALERT_COOLDOWN_MINUTES=15  # Alert cooldown period
ALERT_GROUPING_ENABLED=true  # Enable alert grouping
ALERT_ESCALATION_ENABLED=true  # Enable alert escalation
ALERT_LOG_PATH=${RAID_STORAGE}/logs/alerts.log
ALERT_WEBHOOK_ENABLED=false  # Enable webhook notifications
ALERT_EMAIL_ENABLED=false  # Enable email notifications
ALERT_SLACK_ENABLED=false  # Enable Slack notifications

# Root Cause Analysis
RCA_ENABLED=true  # Enable automated root cause analysis
RCA_LOG_PATH=${RAID_STORAGE}/logs/root-cause-analysis.log
CORRELATION_WINDOW_MINUTES=10  # Time window for event correlation
RCA_AI_ENABLED=false  # Enable AI-powered RCA (future enhancement)
INCIDENT_CORRELATION_THRESHOLD=3  # Minimum events for correlation

# Metrics Collection and Retention
METRICS_RETENTION_DAYS=90  # Metrics retention period
METRICS_COMPRESSION_ENABLED=true  # Enable metrics compression
METRICS_SAMPLING_INTERVAL=15s  # Metrics collection interval
METRICS_BATCH_SIZE=1000  # Metrics batch size for efficient processing

# =========================
# Build Paths (Service Source/Artifacts)
# =========================
DEV_SCRIPTS_PATH=${SERVICE_BASE_PATH}/dev_scripts
CODESERVER_BUILD_PATH=${DEV_SCRIPTS_PATH}/code-server-build
KEYCLOAK_BUILD_PATH=${SERVICE_BASE_PATH}/keycloak
NGINX_BUILD_PATH=${SERVICE_BASE_PATH}/nginx
PLANE_BUILD_PATH=${SERVICE_BASE_PATH}/plane
POSTGRES_BUILD_PATH=${SERVICE_BASE_PATH}/postgres
REDIS_BUILD_PATH=${SERVICE_BASE_PATH}/redis
VAULT_BUILD_PATH=${SERVICE_BASE_PATH}/vault
LOKI_BUILD_PATH=${SERVICE_BASE_PATH}/loki
PROMETHEUS_BUILD_PATH=${SERVICE_BASE_PATH}/prometheus
GRAFANA_BUILD_PATH=${SERVICE_BASE_PATH}/grafana
VIKUNJA_BUILD_PATH=${SERVICE_BASE_PATH}/vikunja
BACKUP_BUILD_PATH=${DATA_BASE_PATH}/backups

# =========================
# Additional Notes
# =========================
# - Sensitive values (e.g., passwords, tokens) are left blank and must be populated by Vault.
# - Use VAULT_DEV_MODE=true for development to bypass Vault with default credentials (log warnings).
# - Services must check dependencies (e.g., PostgreSQL, Redis) in entrypoint.sh scripts.
# - All changes to this file must be logged to /opt/my-secure-ha-stack/logs/dev-environment-setup.log.
# - Follow Conventional Commits for changes (e.g., `feat(config): enhance config.env for container independence`).
# - Create a backup branch before modifying: `git checkout -b backup/$(date +%Y%m%d)-config-env`.

# =========================
# Business Continuity & Disaster Recovery
# =========================
# Disaster Recovery Configuration
DR_ENABLED=true  # Enable disaster recovery procedures
DR_BACKUP_STRATEGY=incremental  # Backup strategy: full, incremental, differential
DR_RTO_TARGET=4  # Recovery Time Objective in hours
DR_RPO_TARGET=1  # Recovery Point Objective in hours
DR_BACKUP_ENCRYPTION=true  # Encrypt disaster recovery backups
DR_OFFSITE_BACKUP=false  # Enable offsite backup replication
DR_AUTOMATED_TESTING=true  # Enable automated DR testing
DR_TEST_SCHEDULE="0 3 * * 0"  # Weekly DR test schedule (Sundays)
DR_LOG_PATH=${RAID_STORAGE}/logs/disaster-recovery.log

# High Availability Configuration
HA_ENABLED=false  # Enable high availability mode
HA_CLUSTER_SIZE=3  # Cluster size for HA deployment
HA_LOAD_BALANCING=round_robin  # Load balancing algorithm
HA_FAILOVER_TIMEOUT=30  # Failover timeout in seconds
HA_HEALTH_CHECK_INTERVAL=10  # HA health check interval
HA_AUTO_SCALING=false  # Enable auto-scaling based on metrics

# Backup and Recovery
BACKUP_ENABLED=true  # Enable automated backups
BACKUP_SCHEDULE="0 2 * * *"  # Daily backup schedule
BACKUP_RETENTION_POLICY=incremental  # Backup retention strategy
BACKUP_COMPRESSION=true  # Enable backup compression
BACKUP_VERIFICATION=true  # Verify backup integrity
BACKUP_NOTIFICATION=false  # Enable backup notifications
BACKUP_PARALLEL_JOBS=3  # Number of parallel backup jobs
BACKUP_BANDWIDTH_LIMIT=100M  # Bandwidth limit for backups

# =========================
# Performance Optimization
# =========================
# Resource Management
RESOURCE_QUOTAS_ENABLED=true  # Enable resource quotas
CPU_QUOTA_LIMIT=80  # CPU quota limit percentage
MEMORY_QUOTA_LIMIT=85  # Memory quota limit percentage
DISK_IO_QUOTA_LIMIT=70  # Disk I/O quota limit percentage
NETWORK_QUOTA_LIMIT=75  # Network quota limit percentage

# Caching Strategy
GLOBAL_CACHE_ENABLED=true  # Enable global caching layer
CACHE_STRATEGY=redis  # Caching strategy: redis, memcached, local
CACHE_TTL_DEFAULT=3600  # Default cache TTL in seconds
CACHE_WARM_UP=true  # Enable cache warm-up on startup
CACHE_COMPRESSION=true  # Enable cache compression
CACHE_EVICTION_POLICY=lru  # Cache eviction policy

# Database Optimization
DB_CONNECTION_POOLING=true  # Enable database connection pooling
DB_QUERY_OPTIMIZATION=true  # Enable query optimization
DB_INDEX_OPTIMIZATION=true  # Enable automatic index optimization
DB_VACUUM_SCHEDULE="0 4 * * 0"  # Weekly database vacuum schedule
DB_ANALYZE_SCHEDULE="0 5 * * *"  # Daily database analyze schedule

# =========================
# Operational Excellence
# =========================
# Change Management
CHANGE_MANAGEMENT_ENABLED=true  # Enable change management
CHANGE_APPROVAL_REQUIRED=false  # Require approval for changes
CHANGE_ROLLBACK_ENABLED=true  # Enable automatic rollback
CHANGE_TESTING_REQUIRED=true  # Require testing before deployment
CHANGE_DOCUMENTATION_REQUIRED=true  # Require change documentation
CHANGE_LOG_PATH=${RAID_STORAGE}/logs/change-management.log

# Deployment Strategy
DEPLOYMENT_STRATEGY=rolling  # Deployment strategy: rolling, blue-green, canary
DEPLOYMENT_TIMEOUT=600  # Deployment timeout in seconds
DEPLOYMENT_HEALTH_CHECK=true  # Enable health checks during deployment
DEPLOYMENT_ROLLBACK_ON_FAILURE=true  # Auto-rollback on deployment failure
DEPLOYMENT_NOTIFICATION=false  # Enable deployment notifications
DEPLOYMENT_LOG_PATH=${RAID_STORAGE}/logs/deployments.log

# Quality Assurance
QA_AUTOMATED_TESTING=true  # Enable automated testing
QA_UNIT_TEST_COVERAGE_MIN=80  # Minimum unit test coverage percentage
QA_INTEGRATION_TESTING=true  # Enable integration testing
QA_PERFORMANCE_TESTING=true  # Enable performance testing
QA_SECURITY_TESTING=true  # Enable security testing
QA_CODE_QUALITY_GATES=true  # Enable code quality gates
QA_STATIC_ANALYSIS=true  # Enable static code analysis

# Environment Management
ENV_PROMOTION_ENABLED=true  # Enable environment promotion
ENV_ISOLATION=true  # Enable environment isolation
ENV_CONFIG_VALIDATION=true  # Validate environment configurations
ENV_DRIFT_DETECTION=true  # Enable configuration drift detection
ENV_CLEANUP_ENABLED=true  # Enable automatic environment cleanup
ENV_CLEANUP_SCHEDULE="0 6 * * *"  # Daily environment cleanup schedule
