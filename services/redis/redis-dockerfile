# Pure Bliss Redis Container - Independent Startup with Vault Integration
# Follows Pure Bliss standards for container independence and security

# Stage 1: Builder stage to fetch dependencies
FROM debian:bullseye-slim as builder

# Install required packages for downloading Vault
RUN apt-get update && apt-get install -y \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install Vault CLI
RUN curl -Lo vault.zip https://releases.hashicorp.com/vault/1.17.3/vault_1.17.3_linux_amd64.zip && \
    unzip vault.zip && \
    mv vault /usr/local/bin/ && \
    chmod +x /usr/local/bin/vault && \
    rm vault.zip

# Stage 2: Final Redis image
FROM redis:7

# Copy Vault CLI from the builder stage
COPY --from=builder /usr/local/bin/vault /usr/local/bin/vault

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    jq \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Copy the comprehensive entrypoint script
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Create necessary directories and set permissions
RUN mkdir -p /data /usr/local/etc/redis /opt/my-secure-ha-stack/logs && \
    chown -R redis:redis /data /usr/local/etc/redis && \
    chmod 777 /opt/my-secure-ha-stack/logs

# Health check for standalone operation
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
  CMD redis-cli ping | grep -q PONG || exit 1

# Expose Redis port
EXPOSE 6379

# Use the comprehensive entrypoint for Vault integration and independent startup
ENTRYPOINT ["/entrypoint.sh"]
CMD []
