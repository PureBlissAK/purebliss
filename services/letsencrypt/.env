# Let's Encrypt with Vault PKI Integration Configuration
LETSENCRYPT_WEBROOT_PATH=/mnt/raid0/nginx/html
LETSENCRYPT_CERT_PATH=/mnt/raid0/nginx/certs/live
LETSENCRYPT_EMAIL=admin@purebliss.app
LETSENCRYPT_DOMAINS=dev.purebliss.app

# Vault PKI Configuration
VAULT_PKI_PATH=pki-letsencrypt
VAULT_PKI_ROLE=letsencrypt-role
VAULT_PKI_TTL=24h
VAULT_PKI_MAX_TTL=168h

# Renewal Configuration
RENEWAL_INTERVAL=1h
ENABLE_VAULT_PKI=true
FALLBACK_TO_TRADITIONAL=true
