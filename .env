# Pure Bliss Development Environment Configuration
# Domain configuration for dev.purebliss.app

# Primary Domain
LOCAL_HOSTNAME=dev.purebliss.app
DOMAIN=dev.purebliss.app

# Service URLs
CODE_SERVER_URL=https://dev.purebliss.app/code-server
KEYCLOAK_URL=https://dev.purebliss.app/keycloak
VAULT_URL=https://dev.purebliss.app/vault
PLANE_URL=https://dev.purebliss.app/plane
GRAFANA_URL=https://dev.purebliss.app/grafana
PROMETHEUS_URL=https://dev.purebliss.app/prometheus
LOKI_URL=https://dev.purebliss.app/loki

# Database Configuration
POSTGRES_DB=purebliss_dev
POSTGRES_USER=purebliss
POSTGRES_PASSWORD=secure_dev_password_2024
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_2024

# Vault Configuration
VAULT_ADDR=https://dev.purebliss.app/vault
VAULT_API_ADDR=https://dev.purebliss.app/vault
VAULT_CLUSTER_ADDR=https://vault:8201

# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secure_2024
KC_HOSTNAME=dev.purebliss.app
KC_HOSTNAME_PATH=/keycloak

# Pure Bliss Application Configuration
APP_NAME="Pure Bliss Development"
APP_ENV=development
APP_DEBUG=true
APP_URL=https://dev.purebliss.app

# Social Media Configuration
HOOTSUITE_API_KEY=your_hootsuite_api_key
INSTAGRAM_ACCESS_TOKEN=your_instagram_token
YOUTUBE_API_KEY=your_youtube_api_key
GEMINI_API_KEY=your_gemini_api_key

# Business Targets
TARGET_CUSTOMERS_YEAR=107500
TARGET_INSTAGRAM_FOLLOWERS=75000
TARGET_YOUTUBE_SUBSCRIBERS=50000
TARGET_ENGAGEMENT_RATE=1.50
DAILY_POSTS_TARGET=70

# Performance Targets
TARGET_UPTIME=99.999
TARGET_API_LATENCY_MS=30
TARGET_TEST_COVERAGE=90

# Container UIDs
CODE_SERVER_UID=1000
CODE_SERVER_GID=1000
NGINX_UID=101
NGINX_GID=101
VAULT_UID=999
VAULT_GID=999

# Logging
LOG_LEVEL=info
LOG_CHANNEL=stack

# Orchestrator Configuration
ORCHESTRATOR_CHECK_INTERVAL=30
TMUX_SESSION_PREFIX=pure-bliss

# SSL/TLS Configuration
SSL_CERT_PATH=/opt/dev-purebliss/services/letsencrypt/live/dev.purebliss.app
SSL_KEY_PATH=/opt/dev-purebliss/services/letsencrypt/live/dev.purebliss.app

# Backup Configuration
BACKUP_PATH=/opt/dev-purebliss/backups
BACKUP_RETENTION_DAYS=30

# Network Configuration
DOCKER_NETWORK=purebliss-net
PASSWORD=$(vault read -field=password secrets/data/codeserver/password)
