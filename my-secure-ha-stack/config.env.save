# Pure Bliss Development Environment - Centralized Environment Variables
# This file centralizes all key environment variables for orchestration and service configuration.
# Update values as needed for your deployment.

# General
ENVIRONMENT=development
LOCAL_HOSTNAME=dev.purebliss.app
DOMAIN=dev.purebliss.app
NETWORK_NAME=purebliss-net
LOG_LEVEL=INFO

# RAID0 Persistent Storage
RAID0_MOUNT=/mnt/raid0

# Nginx SSL Cert Path (must be set before SSL_CERT_PATH, etc)
NGINX_SSL_CERT_PATH=${RAID0_MOUNT}/nginx/certs

# =========================
# HTTPS / SSL / TLS Defaults (applies to all services)
ENABLE_HTTPS=true
SSL_CERT_PATH=${NGINX_SSL_CERT_PATH}/fullchain.pem
SSL_KEY_PATH=${NGINX_SSL_CERT_PATH}/privkey.pem
SSL_CA_PATH=${NGINX_SSL_CERT_PATH}/chain.pem
TLS_VERSION=TLSv1.3
SSL_CIPHERS=ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305
HSTS_HEADER="max-age=63072000; includeSubDomains; preload"
FORCE_HTTPS_REDIRECT=true
# =========================

# Vault
VAULT_ADDR=http://purebliss-vault:8200
VAULT_TOKEN=
VAULT_UNSEAL_KEY_1=
VAULT_UNSEAL_KEY_2=
VAULT_UNSEAL_KEY_3=
VAULT_DATA_PATH=${RAID0_MOUNT}/vault/data
VAULT_TLS_PATH=${RAID0_MOUNT}/vault/tls
VAULT_AGENT_LOG_PATH=${RAID0_MOUNT}/logs/vault-agent.log

# =========================
# VAULT UNSEAL KEYS & ROOT (DEVELOPMENT ONLY)
# DO NOT USE IN PRODUCTION. Store these securely in production!
VAULT_DEV_ROOT_TOKEN=myroot
VAULT_DEV_UNSEAL_KEY_1=replace_with_unseal_key_1
VAULT_DEV_UNSEAL_KEY_2=replace_with_unseal_key_2
VAULT_DEV_UNSEAL_KEY_3=replace_with_unseal_key_3
# =========================

# Vault Agent
VAULT_AGENT_CONFIG_PATH=/opt/dev-purebliss/services/vault/vault-agent/config.hcl
VAULT_AGENT_ROLE_ID_PATH=/opt/dev-purebliss/services/vault/vault-agent/role_id
VAULT_AGENT_SECRET_ID_PATH=/opt/dev-purebliss/services/vault/vault-agent/secret_id
VAULT_AGENT_TEMPLATES_PATH=/opt/dev-purebliss/services/vault/vault-agent/
VAULT_AGENT_OUTPUT_PATH=/opt/dev-purebliss/services/vault/vault-agent/

# PostgreSQL
POSTGRES_HOST=purebliss-postgres
POSTGRES_PORT=5432
POSTGRES_DB=purebliss_app
POSTGRES_USER=vault_admin
POSTGRES_PASSWORD=vault_password
POSTGRES_DATA_PATH=${RAID0_MOUNT}/postgres/postgres-data
POSTGRES_LOG_PATH=${RAID0_MOUNT}/logs/postgres.log

# Redis
REDIS_HOST=purebliss-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATA_PATH=${RAID0_MOUNT}/redis/data
REDIS_LOG_PATH=${RAID0_MOUNT}/logs/redis.log

# Plane (Issue Tracker)
PLANE_HOST=purebliss-plane
PLANE_PORT=8081
PLANE_API_URL=https://dev.purebliss.app/plane
PLANE_DATA_PATH=${RAID0_MOUNT}/plane/data
PLANE_LOG_PATH=${RAID0_MOUNT}/logs/plane.log

# Keycloak
KEYCLOAK_HOST=purebliss-keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=planerealm
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_DATA_PATH=${RAID0_MOUNT}/keycloak/data
KEYCLOAK_LOG_PATH=${RAID0_MOUNT}/logs/keycloak.log

# Nginx
NGINX_HOST=purebliss-nginx
NGINX_PORT=443
NGINX_HTTP_PORT=80
NGINX_LOG_PATH=${RAID0_MOUNT}/logs/nginx.log

# Loki
LOKI_HOST=purebliss-loki
LOKI_PORT=3100
LOKI_DATA_PATH=${RAID0_MOUNT}/loki/data
LOKI_LOG_PATH=${RAID0_MOUNT}/logs/loki.log

# Prometheus
PROMETHEUS_HOST=purebliss-prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_DATA_PATH=${RAID0_MOUNT}/prometheus/data
PROMETHEUS_LOG_PATH=${RAID0_MOUNT}/logs/prometheus.log

# Grafana
GRAFANA_HOST=purebliss-grafana
GRAFANA_PORT=3001
GRAFANA_DATA_PATH=${RAID0_MOUNT}/grafana/data
GRAFANA_LOG_PATH=${RAID0_MOUNT}/logs/grafana.log

# CodeServer
CODESERVER_HOST=purebliss-code-server
CODESERVER_PORT=8443
CODESERVER_DATA_PATH=${RAID0_MOUNT}/code-server/data
CODESERVER_LOG_PATH=${RAID0_MOUNT}/logs/code-server.log

# Let's Encrypt / Certbot
LETSENCRYPT_EMAIL=admin@purebliss.app
LETSENCRYPT_DOMAINS=dev.purebliss.app
LETSENCRYPT_WEBROOT_PATH=/var/www/html
LETSENCRYPT_CERT_PATH=${RAID0_MOUNT}/nginx/certs/live
LETSENCRYPT_RENEW_SCRIPT=/opt/dev-purebliss/services/dev_scripts/certbot-scripts/renew-certs.sh
LETSENCRYPT_CRON_SCHEDULE="0 3 * * *"

# Backups
BACKUP_PATH=${RAID0_MOUNT}/backups

# Logging
LOG_PATH=${RAID0_MOUNT}/logs/dev-environment-setup.log

# Build Paths (Service Source/Artifacts)
CODESERVER_BUILD_PATH=/opt/dev-purebliss/services/dev_scripts/code-server-build
KEYCLOAK_BUILD_PATH=/opt/dev-purebliss/services/keycloak
NGINX_BUILD_PATH=/opt/dev-purebliss/services/nginx
PLANE_BUILD_PATH=/opt/dev-purebliss/services/plane
POSTGRES_BUILD_PATH=/opt/dev-purebliss/services/postgres
REDIS_BUILD_PATH=/opt/dev-purebliss/services/redis
VAULT_BUILD_PATH=/opt/dev-purebliss/services/vault
LOKI_BUILD_PATH=/opt/dev-purebliss/services/loki
PROMETHEUS_BUILD_PATH=/opt/dev-purebliss/services/prometheus
GRAFANA_BUILD_PATH=/opt/dev-purebliss/services/grafana
BACKUP_BUILD_PATH=/opt/my-secure-ha-stack/backups

# Secrets Management
SECRETS_PROVIDER=vault
SECRETS_VAULT_ADDR=${VAULT_ADDR}
SECRETS_VAULT_ROLE_ID_PATH=${VAULT_AGENT_ROLE_ID_PATH}
SECRETS_VAULT_SECRET_ID_PATH=${VAULT_AGENT_SECRET_ID_PATH}
SECRETS_VAULT_TOKEN_PATH=${VAULT_AGENT_OUTPUT_PATH}/token
SECRETS_VAULT_NAMESPACE=
SECRETS_VAULT_ENGINE=kv-v2
SECRETS_VAULT_POLICY=purebliss-agent-policy
# All services must use Vault for secrets; do not use static secrets or .env files for sensitive data.

# Service-specific Docker Compose and config file names
NGINX_DOCKER_COMPOSE_FILE=nginx-docker-compose.yml
LETSENCRYPT_DOCKER_COMPOSE_FILE=letsencrypt-docker-compose.yml
VAULT_DOCKER_COMPOSE_FILE=vault-docker-compose.yml
VAULT_AGENT_DOCKER_COMPOSE_FILE=vault-agent-docker-compose.yml
REDIS_DOCKER_COMPOSE_FILE=redis-docker-compose.yml
POSTGRES_DOCKER_COMPOSE_FILE=postgres-docker-compose.yml
KEYCLOAK_DOCKER_COMPOSE_FILE=keycloak-docker-compose.yml
GRAFANA_DOCKER_COMPOSE_FILE=grafana-docker-compose.yml
LOKI_DOCKER_COMPOSE_FILE=loki-docker-compose.yml
PROMETHEUS_DOCKER_COMPOSE_FILE=prometheus-docker-compose.yml
PLANE_DOCKER_COMPOSE_FILE=plane-docker-compose.yml
CODESERVER_DOCKER_COMPOSE_FILE=codeserver-docker-compose.yml

# Service-specific Dockerfile names
NGINX_DOCKERFILE=nginx-dockerfile
LETSENCRYPT_DOCKERFILE=letsencrypt-dockerfile
VAULT_DOCKERFILE=vault-dockerfile
VAULT_AGENT_DOCKERFILE=vault-agent-dockerfile
REDIS_DOCKERFILE=redis-dockerfile
POSTGRES_DOCKERFILE=postgres-dockerfile
KEYCLOAK_DOCKERFILE=keycloak-dockerfile
GRAFANA_DOCKERFILE=grafana-dockerfile
LOKI_DOCKERFILE=loki-dockerfile
PROMETHEUS_DOCKERFILE=prometheus-dockerfile
PLANE_DOCKERFILE=plane-dockerfile
CODESERVER_DOCKERFILE=codeserver-dockerfile
# Add more as needed for other services

# Add any additional service-specific variables below as needed
