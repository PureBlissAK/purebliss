APP_NAME=PureBliss
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dev.purebliss.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=purebliss-postgres
DB_PORT=5432
DB_DATABASE=purebliss
DB_USERNAME=postgres
DB_PASSWORD=changeme

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=dev.purebliss.app

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@purebliss.app"
MAIL_FROM_NAME="PureBliss"

KEYCLOAK_URL=https://dev.purebliss.app/keycloak
VAULT_ADDR=https://vault.purebliss.app:8200
SANCTUM_STATEFUL_DOMAINS=dev.purebliss.app

VITE_APP_NAME="PureBliss"
keycloak_USER=$(vault read -field=username database/creds/keycloak)
plane_USER=$(vault read -field=username database/creds/plane)
keycloak_PASSWORD=$(vault read -field=password database/creds/keycloak)
plane_PASSWORD=$(vault read -field=password database/creds/plane)
letsencrypt_USER=$(vault read -field=username database/creds/letsencrypt)
letsencrypt_PASSWORD=$(vault read -field=password database/creds/letsencrypt)
PASSWORD=$(vault read -field=password secrets/data/codeserver/password)
