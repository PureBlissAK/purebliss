{
  "name": "pure-bliss-frontend",
  "version": "1.0.0",
  "description": "Pure Bliss Elite Social Media Technology Stack - React Native Frontend",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "start": "react-native start",
    "metro": "react-native start",
    "static": "npx expo start --web --non-interactive --clear --port 19006",
    "web": "expo start:web --port 3000",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "storybook": "expo start --clear --dev-client",
    "mock-api": "json-server --watch mock-api/db.json --port 4000",
    "typecheck": "tsc --noEmit",
    "clean": "react-native clean",
    "pod-install": "cd ios && pod install",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "react-native run-ios --configuration Release"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.1.3",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-firebase/app": "^20.1.0",
    "@react-native-firebase/auth": "^20.1.0",
    "@react-native-firebase/firestore": "^20.1.0",
    "@react-native-firebase/messaging": "^20.1.0",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/stack": "^6.3.29",
    "@reduxjs/toolkit": "^2.2.6",
    "axios": "^1.7.2",
    "lottie-react-native": "^6.7.2",
    "react": "18.2.0",
    "react-dom": "^19.1.1",
    "react-native": "0.75.0",
    "react-native-elements": "^3.4.3",
    "react-native-flipper": "^0.212.0",
    "react-native-gesture-handler": "^2.17.1",
    "react-native-image-picker": "^7.1.2",
    "react-native-keychain": "^8.2.0",
    "react-native-maps": "^1.15.6",
    "react-native-permissions": "^4.1.5",
    "react-native-reanimated": "^3.14.0",
    "react-native-safe-area-context": "^4.10.8",
    "react-native-screens": "^3.32.0",
    "react-native-vector-icons": "^10.1.0",
    "react-native-web": "^0.19.13",
    "react-query": "^3.39.3",
    "react-redux": "^9.1.2",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.75.0",
    "@react-native/eslint-config": "0.75.0",
    "@react-native/metro-config": "0.75.0",
    "@react-native/typescript-config": "0.75.0",
    "@storybook/cli": "^9.1.0",
    "@storybook/react-native": "^9.1.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.5.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "detox": "^20.19.3",
    "eslint": "^8.19.0",
    "expo": "^50.0.0",
    "jest": "^29.6.3",
    "json-server": "^1.0.0-beta.3",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "2.8.8",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.0.0"
}
